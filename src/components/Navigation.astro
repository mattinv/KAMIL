---
const navLinks = [
  { label: 'Strona główna', href: '/' },
  { label: 'Usługi', href: '/uslugi' },
  { label: 'Realizacje', href: '/realizacje' },
  { label: 'O nas', href: '/o-nas' },
  { label: 'Kontakt', href: '/kontakt' },
];
---

<header
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <nav class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <img
          src="/logo.png"
          alt="Elewacje z Klasą"
          class="h-12 w-auto transition-transform group-hover:scale-105"
        />
      </a>

      <!-- Desktop Links -->
      <div class="hidden lg:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link px-4 py-2 text-sm font-medium text-slate-200 hover:text-orange-400 rounded-lg transition-all duration-300 hover:bg-white/5"
          >
            {link.label}
          </a>
        ))}
        <a
          href="/kontakt"
          class="ml-4 px-6 py-2.5 bg-red-600 hover:bg-red-500 text-white text-sm font-semibold rounded-lg transition-all duration-300 hover:shadow-lg hover:shadow-red-600/25"
        >
          Darmowa Wycena
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden flex flex-col gap-1.5 p-2"
        aria-label="Menu"
      >
        <span class="hamburger-line w-6 h-0.5 bg-white transition-all duration-300 origin-center"></span>
        <span class="hamburger-line w-6 h-0.5 bg-white transition-all duration-300"></span>
        <span class="hamburger-line w-4 h-0.5 bg-white transition-all duration-300 origin-center"></span>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden fixed inset-0 top-20 bg-slate-950/98 backdrop-blur-xl z-40"
  >
    <div class="flex flex-col items-center justify-center gap-6 p-8 pt-16">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link text-2xl font-semibold text-white hover:text-orange-400 transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/kontakt"
        class="mt-4 px-8 py-3.5 bg-red-600 hover:bg-red-500 text-white text-lg font-bold rounded-xl transition-all"
      >
        Darmowa Wycena
      </a>
    </div>
  </div>
</header>

<script>
  // Sticky nav scroll effect
  const nav = document.getElementById('main-nav');

  function updateNav() {
    if (!nav) return;
    const scrolled = window.scrollY > 60;

    if (scrolled) {
      nav.classList.add('bg-slate-950/95', 'backdrop-blur-xl', 'shadow-lg', 'shadow-black/10');
      nav.classList.remove('bg-transparent');
    } else {
      nav.classList.remove('bg-slate-950/95', 'backdrop-blur-xl', 'shadow-lg', 'shadow-black/10');
      nav.classList.add('bg-transparent');
    }
  }

  window.addEventListener('scroll', updateNav, { passive: true });
  updateNav();

  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerLines = menuBtn?.querySelectorAll('.hamburger-line');

  menuBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');

    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      if (hamburgerLines) {
        hamburgerLines[0].classList.remove('rotate-45', 'translate-y-2');
        hamburgerLines[1].classList.remove('opacity-0');
        hamburgerLines[2].classList.remove('-rotate-45', '-translate-y-2', 'w-6');
        hamburgerLines[2].classList.add('w-4');
      }
    } else {
      mobileMenu?.classList.remove('hidden');
      if (hamburgerLines) {
        hamburgerLines[0].classList.add('rotate-45', 'translate-y-2');
        hamburgerLines[1].classList.add('opacity-0');
        hamburgerLines[2].classList.add('-rotate-45', '-translate-y-2', 'w-6');
        hamburgerLines[2].classList.remove('w-4');
      }
    }
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
    });
  });
</script>
