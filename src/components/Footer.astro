---
import type { Locale } from '../i18n/config';
import { localePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'pl' } = Astro.props;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();

const footerLinks = {
  uslugi: [
    { label: t('footer.link.houseInsulation'), href: localePath('/uslugi/ocieplenie-domu-krakow', locale) },
    { label: t('footer.link.ventilatedFacades'), href: localePath('/uslugi/elewacje-wentylowane-krakow', locale) },
    { label: t('footer.link.thermalModernization'), href: localePath('/uslugi/termomodernizacja-malopolska', locale) },
    { label: t('footer.link.allServices'), href: localePath('/uslugi', locale) },
  ],
  firma: [
    { label: t('footer.link.about'), href: localePath('/o-nas', locale) },
    { label: t('footer.link.projects'), href: localePath('/realizacje', locale) },
    { label: t('footer.link.blog'), href: localePath('/poradnik', locale) },
    { label: t('footer.link.contact'), href: localePath('/kontakt', locale) },
  ],
};

const contactHref = localePath('/kontakt', locale);
---

<footer class="bg-slate-950 text-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Main footer -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 py-16 lg:py-20">
      <!-- Brand -->
      <div class="lg:col-span-1 space-y-6">
        <a href={localePath('/', locale)} class="inline-block">
          <img src="/logo.png" alt="Elewacje z Klasą" class="h-16 w-auto brightness-0 invert" />
        </a>
        <p class="text-slate-400 text-sm leading-relaxed">
          {t('footer.brandDescription')}
        </p>
        <div class="text-slate-400 text-sm space-y-1">
          <p>Kobierzyńska 103/5</p>
          <p>30-382 Kraków</p>
          <p>NIP: 6762421312</p>
          <p><a href="mailto:biuro@elewacjezklasa.pl" class="hover:text-orange-400 transition-colors">biuro@elewacjezklasa.pl</a></p>
        </div>
        <!-- Social icons -->
        <div class="flex gap-3">
          <a href="#" class="w-10 h-10 rounded-lg bg-slate-800 hover:bg-red-600 flex items-center justify-center transition-colors duration-300" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href="#" class="w-10 h-10 rounded-lg bg-slate-800 hover:bg-red-600 flex items-center justify-center transition-colors duration-300" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
          <a href="#" class="w-10 h-10 rounded-lg bg-slate-800 hover:bg-red-600 flex items-center justify-center transition-colors duration-300" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Usługi / Services -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-slate-300 mb-6">{t('footer.services')}</h4>
        <ul class="space-y-3">
          {footerLinks.uslugi.map((link) => (
            <li>
              <a href={link.href} class="text-slate-400 hover:text-orange-400 text-sm transition-colors duration-300">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Firma / Company -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-slate-300 mb-6">{t('footer.company')}</h4>
        <ul class="space-y-3">
          {footerLinks.firma.map((link) => (
            <li>
              <a href={link.href} class="text-slate-400 hover:text-orange-400 text-sm transition-colors duration-300">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- CTA -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-slate-300 mb-6">{t('footer.ctaTitle')}</h4>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">
          {t('footer.ctaDescription')}
        </p>
        <a
          href={contactHref}
          class="inline-flex items-center gap-2 px-6 py-3 bg-red-600 hover:bg-red-500 text-white font-semibold text-sm rounded-xl transition-all duration-300"
        >
          {t('footer.ctaButton')}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-slate-800 py-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-slate-500 text-sm">
        &copy; {currentYear} Elewacje z Klasą. {t('footer.copyright')}
      </p>
      <div class="flex gap-6 text-sm">
        <a href="#" class="text-slate-500 hover:text-slate-300 transition-colors">{t('footer.privacy')}</a>
        <a href="#" class="text-slate-500 hover:text-slate-300 transition-colors">{t('footer.terms')}</a>
      </div>
    </div>
  </div>
</footer>
