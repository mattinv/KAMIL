---
import type { Locale } from '../i18n/config';

interface Props {
  locale?: Locale;
}

const { locale = 'pl' } = Astro.props;
const en = locale === 'en';

const stats = [
  { value: '15+', label: en ? 'Years of experience' : 'Lat doświadczenia' },
  { value: '300+', label: en ? 'Completed projects' : 'Zrealizowanych projektów' },
  { value: '98%', label: en ? 'Satisfied clients' : 'Zadowolonych klientów' },
  { value: '50k+', label: en ? 'Sq meters of facade' : 'Metrów kw. elewacji' },
];
---

<section class="relative -mt-16 z-20 max-w-6xl mx-auto px-6 lg:px-8">
  <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 border border-slate-100 p-8 lg:p-0">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-0 lg:divide-x divide-slate-100">
      {stats.map((stat) => (
        <div class="text-center lg:py-10 lg:px-8 group">
          <p class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight group-hover:text-orange-500 transition-colors duration-300">
            {stat.value}
          </p>
          <p class="mt-2 text-sm text-slate-500 font-medium uppercase tracking-wider">
            {stat.label}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
