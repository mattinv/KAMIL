---
import type { Locale } from '../i18n/config';

interface Props {
  type?: 'home' | 'services' | 'projects' | 'about' | 'contact' | 'blog' | 'article';
  locale?: Locale;
  articleData?: {
    title: string;
    description: string;
    date: string;
    url: string;
  };
  faqItems?: { q: string; a: string }[];
  projectItems?: { title: string; description: string; image: string; location: string; year: number; slug: string }[];
}

const { type = 'home', locale = 'pl', articleData, faqItems, projectItems } = Astro.props;

const baseUrl = 'https://www.elewacjezklasa.pl';

const organization = {
  '@type': 'LocalBusiness',
  '@id': `${baseUrl}/#organization`,
  name: 'Elewacje z Klasą',
  alternateName: 'Elewacje z Klasą — Kamil Ochałek',
  url: baseUrl,
  logo: `${baseUrl}/logo.png`,
  image: `${baseUrl}/og-image.jpg`,
  description: 'Profesjonalne usługi elewacyjne i ociepleniowe w Krakowie i Małopolsce. Systemy ETICS, elewacje wentylowane, projekty komercyjne.',
  telephone: ['+48515156233'],
  email: 'biuro@elewacjezklasa.pl',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Kobierzyńska 103/5',
    addressLocality: 'Kraków',
    postalCode: '30-382',
    addressCountry: 'PL',
    addressRegion: 'Małopolska',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 50.0357,
    longitude: 19.9217,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '07:00',
      closes: '17:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '08:00',
      closes: '14:00',
    },
  ],
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Małopolska',
  },
  priceRange: '$$',
  taxID: '6762421312',
  sameAs: [],
};

const services = [
  {
    '@type': 'Service',
    name: 'Systemy Ociepleń ETICS',
    description: 'Kompleksowe ocieplenia budynków metodą lekką-mokrą z certyfikowanymi systemami Weber, Baumit i Caparol.',
    provider: { '@id': `${baseUrl}/#organization` },
    areaServed: 'Małopolska',
    url: `${baseUrl}/uslugi#etics`,
  },
  {
    '@type': 'Service',
    name: 'Elewacje Wentylowane',
    description: 'Nowoczesne fasady wentylowane z płyt HPL, włókno-cementowych oraz paneli aluminiowych. Trwałość ponad 50 lat.',
    provider: { '@id': `${baseUrl}/#organization` },
    areaServed: 'Małopolska',
    url: `${baseUrl}/uslugi#wentylowane`,
  },
  {
    '@type': 'Service',
    name: 'Projekty Komercyjne',
    description: 'Realizacje elewacji dla deweloperów, inwestorów i sektora publicznego — biurowce, hale, centra handlowe.',
    provider: { '@id': `${baseUrl}/#organization` },
    areaServed: 'Małopolska',
    url: `${baseUrl}/uslugi#komercyjne`,
  },
];

// Build breadcrumb based on page type and locale
const breadcrumbMapPl: Record<string, { name: string; url: string }[]> = {
  home: [],
  services: [{ name: 'Usługi', url: `${baseUrl}/uslugi` }],
  projects: [{ name: 'Realizacje', url: `${baseUrl}/realizacje` }],
  about: [{ name: 'O nas', url: `${baseUrl}/o-nas` }],
  contact: [{ name: 'Kontakt', url: `${baseUrl}/kontakt` }],
  blog: [{ name: 'Poradnik', url: `${baseUrl}/poradnik` }],
  article: [
    { name: 'Poradnik', url: `${baseUrl}/poradnik` },
    ...(articleData ? [{ name: articleData.title, url: articleData.url }] : []),
  ],
};

const breadcrumbMapEn: Record<string, { name: string; url: string }[]> = {
  home: [],
  services: [{ name: 'Services', url: `${baseUrl}/en/services` }],
  projects: [{ name: 'Projects', url: `${baseUrl}/en/projects` }],
  about: [{ name: 'About', url: `${baseUrl}/en/about` }],
  contact: [{ name: 'Contact', url: `${baseUrl}/en/contact` }],
  blog: [{ name: 'Blog', url: `${baseUrl}/en/blog` }],
  article: [
    { name: 'Blog', url: `${baseUrl}/en/blog` },
    ...(articleData ? [{ name: articleData.title, url: articleData.url }] : []),
  ],
};

const breadcrumbMap = locale === 'en' ? breadcrumbMapEn : breadcrumbMapPl;
const breadcrumbItems = [
  { name: locale === 'en' ? 'Home' : 'Strona główna', url: locale === 'en' ? `${baseUrl}/en/` : baseUrl },
  ...(breadcrumbMap[type] || []),
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: item.url,
  })),
};

// Homepage gets full Organization + Services schema
const homeSchema = {
  '@context': 'https://schema.org',
  '@graph': [organization, ...services],
};

// Services page gets just services
const servicesSchema = {
  '@context': 'https://schema.org',
  '@graph': services,
};

// Article page gets Article schema
const articleSchema = articleData ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: articleData.title,
  description: articleData.description,
  datePublished: articleData.date,
  dateModified: articleData.date,
  author: {
    '@type': 'Organization',
    '@id': `${baseUrl}/#organization`,
    name: 'Elewacje z Klasą',
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${baseUrl}/#organization`,
    name: 'Elewacje z Klasą',
    logo: {
      '@type': 'ImageObject',
      url: `${baseUrl}/logo.png`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleData.url,
  },
} : null;

// Projects ItemList schema for portfolio page
const projectsSchema = projectItems && projectItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Realizacje Elewacji — Elewacje z Klasą',
  itemListElement: projectItems.map((project, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'CreativeWork',
      name: project.title,
      description: project.description,
      image: `${baseUrl}${project.image}`,
      url: `${baseUrl}/realizacje/${project.slug}`,
      dateCreated: `${project.year}`,
      locationCreated: {
        '@type': 'Place',
        name: project.location,
      },
      creator: {
        '@type': 'Organization',
        '@id': `${baseUrl}/#organization`,
        name: 'Elewacje z Klasą',
      },
    },
  })),
} : null;

// FAQPage schema for pages with FAQ sections
const faqSchema = faqItems && faqItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
} : null;
---

{type === 'home' && (
  <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
)}

{type === 'services' && (
  <script type="application/ld+json" set:html={JSON.stringify(servicesSchema)} />
)}

{type === 'article' && articleSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}

{projectsSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(projectsSchema)} />
)}

{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
