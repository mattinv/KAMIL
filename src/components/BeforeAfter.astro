---
import type { Locale } from '../i18n/config';

interface Props {
  locale?: Locale;
}

const { locale = 'pl' } = Astro.props;
const en = locale === 'en';
---

<section class="section-padding bg-slate-900">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-600/10 border border-red-600/20 mb-6">
        <span class="text-red-400 text-sm font-semibold">{en ? 'Before & After' : 'Przed & Po'}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
        {en ? 'See the results of' : 'Zobacz efekty'}<br />
        <span class="text-gradient">{en ? 'our work' : 'naszej pracy'}</span>
      </h2>
      <p class="mt-6 text-lg text-slate-400 leading-relaxed">
        {en
          ? 'Drag the slider to see the facade transformation — from a damaged facade to a modern, energy-efficient building.'
          : 'Przesuń suwak, aby zobaczyć metamorfozę elewacji — od zniszczonej fasady do nowoczesnego, energooszczędnego budynku.'}
      </p>
    </div>

    <!-- Before/After Slider -->
    <div class="max-w-2xl mx-auto">
      <div
        id="ba-slider"
        class="relative aspect-[3/4] rounded-2xl overflow-hidden cursor-ew-resize select-none shadow-2xl shadow-black/30"
      >
        <!-- "Before" side (full background) -->
        <div class="absolute inset-0">
          <img
            src="/images/before.jpeg"
            alt={en ? 'Building facade before renovation' : 'Elewacja budynku przed renowacją'}
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <!-- "Before" label -->
          <div class="absolute top-4 left-4 px-3 py-1.5 bg-red-500/90 backdrop-blur-sm text-white text-xs font-bold uppercase tracking-wider rounded-lg shadow-lg">
            {en ? 'Before' : 'Przed'}
          </div>
        </div>

        <!-- "After" side (clipped) -->
        <div id="ba-after" class="absolute inset-0" style="clip-path: inset(0 50% 0 0);">
          <img
            src="/images/after.png"
            alt={en ? 'Building facade after renovation — silicone plaster with stone cladding' : 'Elewacja budynku po renowacji — tynk silikonowy z okładziną kamienną'}
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <!-- "After" label -->
          <div class="absolute top-4 left-4 px-3 py-1.5 bg-emerald-500/90 backdrop-blur-sm text-white text-xs font-bold uppercase tracking-wider rounded-lg shadow-lg">
            {en ? 'After' : 'Po'}
          </div>
        </div>

        <!-- Slider handle -->
        <div id="ba-handle" class="absolute top-0 bottom-0 w-1 bg-white shadow-lg shadow-black/30 cursor-ew-resize z-10" style="left: 50%;">
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-12 h-12 bg-white rounded-full shadow-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4-4 4 4m0 6l-4 4-4-4" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Instruction -->
      <p class="text-center text-slate-500 text-sm mt-6">
        {en ? '← Drag slider left and right →' : '← Przesuń suwak w lewo i prawo →'}
      </p>
    </div>
  </div>
</section>

<script>
  const slider = document.getElementById('ba-slider');
  const handle = document.getElementById('ba-handle');
  const afterEl = document.getElementById('ba-after');
  let isDragging = false;

  function updateSlider(x: number) {
    if (!slider || !handle || !afterEl) return;
    const rect = slider.getBoundingClientRect();
    let pct = ((x - rect.left) / rect.width) * 100;
    pct = Math.max(2, Math.min(98, pct));
    handle.style.left = `${pct}%`;
    afterEl.style.clipPath = `inset(0 ${100 - pct}% 0 0)`;
  }

  slider?.addEventListener('mousedown', (e) => {
    isDragging = true;
    updateSlider(e.clientX);
  });

  window.addEventListener('mousemove', (e) => {
    if (isDragging) updateSlider(e.clientX);
  });

  window.addEventListener('mouseup', () => {
    isDragging = false;
  });

  // Touch support
  slider?.addEventListener('touchstart', (e) => {
    isDragging = true;
    updateSlider(e.touches[0].clientX);
  }, { passive: true });

  window.addEventListener('touchmove', (e) => {
    if (isDragging) updateSlider(e.touches[0].clientX);
  }, { passive: true });

  window.addEventListener('touchend', () => {
    isDragging = false;
  });
</script>
