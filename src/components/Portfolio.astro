---
const projects = [
  {
    title: 'Osiedle Domów Jednorodzinnych',
    category: 'dom',
    categoryLabel: 'Dom Jednorodzinny',
    description: 'Elewacja tynk silikonowy biało-grafitowy',
    area: '1,200 m²',
    image: '/images/projects/osiedle-front.jpg',
  },
  {
    title: 'Kamienica Miejska',
    category: 'komercyjny',
    categoryLabel: 'Obiekt Komercyjny',
    description: 'Nowoczesna elewacja z przeszkleniami',
    area: '800 m²',
    image: '/images/projects/kamienica-front.jpg',
  },
  {
    title: 'Dom Parterowy z Drewnem',
    category: 'dom',
    categoryLabel: 'Dom Jednorodzinny',
    description: 'Tynk silikonowy z detalami drewnopodobnymi',
    area: '180 m²',
    image: '/images/projects/dom-parterowy.jpg',
  },
  {
    title: 'Dom Nowoczesny — Ciemna Elewacja',
    category: 'dom',
    categoryLabel: 'Dom Jednorodzinny',
    description: 'Elewacja w ciemnej kolorystyce grafitowej',
    area: '240 m²',
    image: '/images/projects/dom-ciemny.jpg',
  },
  {
    title: 'Bliźniak — Budowa',
    category: 'dom',
    categoryLabel: 'Dom Jednorodzinny',
    description: 'Ocieplenie i tynk na etapie budowy',
    area: '320 m²',
    image: '/images/projects/blizniak-budowa.jpg',
  },
  {
    title: 'Kamienica — Elewacja Boczna',
    category: 'komercyjny',
    categoryLabel: 'Obiekt Komercyjny',
    description: 'Renowacja elewacji budynku wielorodzinnego',
    area: '600 m²',
    image: '/images/projects/kamienica-boczna.jpg',
  },
];
---

<section id="realizacje" class="section-padding bg-slate-50">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-50 border border-orange-200 mb-6">
        <span class="text-orange-600 text-sm font-semibold">Realizacje</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
        Nasze najlepsze<br />
        <span class="text-gradient">projekty</span>
      </h2>
      <p class="mt-6 text-lg text-slate-500 leading-relaxed">
        Zobacz wybrane realizacje elewacji i ociepleń dla klientów
        indywidualnych oraz obiektów komercyjnych.
      </p>
    </div>

    <!-- Filter Tabs -->
    <div class="flex justify-center gap-2 mb-12">
      <button
        class="filter-btn active px-6 py-2.5 rounded-xl text-sm font-semibold transition-all duration-300 bg-slate-900 text-white"
        data-filter="all"
      >
        Wszystkie
      </button>
      <button
        class="filter-btn px-6 py-2.5 rounded-xl text-sm font-semibold transition-all duration-300 bg-white text-slate-600 border border-slate-200 hover:border-slate-300"
        data-filter="dom"
      >
        Dom Jednorodzinny
      </button>
      <button
        class="filter-btn px-6 py-2.5 rounded-xl text-sm font-semibold transition-all duration-300 bg-white text-slate-600 border border-slate-200 hover:border-slate-300"
        data-filter="komercyjny"
      >
        Obiekt Komercyjny
      </button>
    </div>

    <!-- Projects Grid (Masonry-like) -->
    <div id="projects-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project, index) => (
        <div
          class={`project-card group relative rounded-2xl overflow-hidden border border-slate-100 bg-white hover:shadow-2xl hover:shadow-slate-900/10 transition-all duration-500 hover:-translate-y-1 ${index === 1 || index === 4 ? 'md:row-span-2' : ''}`}
          data-category={project.category}
        >
          <!-- Project image -->
          <div class={`aspect-[4/3] ${index === 1 || index === 4 ? 'md:aspect-[3/4]' : ''} bg-slate-200 relative overflow-hidden`}>
            <img src={project.image} alt={project.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
            <!-- Overlay on hover -->
            <div class="absolute inset-0 bg-slate-900/0 group-hover:bg-slate-900/40 transition-colors duration-500 flex items-center justify-center">
              <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 transform translate-y-4 group-hover:translate-y-0">
                <div class="w-14 h-14 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                  </svg>
                </div>
              </div>
            </div>
            <!-- Category badge -->
            <div class="absolute top-4 left-4">
              <span class="px-3 py-1 bg-white/90 backdrop-blur-sm text-xs font-semibold text-slate-700 rounded-lg">
                {project.categoryLabel}
              </span>
            </div>
          </div>

          <!-- Content -->
          <div class="p-6">
            <h3 class="text-lg font-bold text-slate-900 group-hover:text-orange-500 transition-colors">
              {project.title}
            </h3>
            <p class="text-slate-500 text-sm mt-1">{project.description}</p>
            <div class="mt-4 flex items-center justify-between">
              <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">{project.area}</span>
              <svg class="w-5 h-5 text-slate-300 group-hover:text-orange-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- View all link -->
    <div class="text-center mt-12">
      <a
        href="/realizacje"
        class="inline-flex items-center gap-2 px-8 py-3.5 border-2 border-slate-900 text-slate-900 font-bold rounded-xl hover:bg-slate-900 hover:text-white transition-all duration-300"
      >
        Zobacz wszystkie realizacje
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      // Update active button
      filterBtns.forEach((b) => {
        b.classList.remove('bg-slate-900', 'text-white');
        b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      });
      btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      btn.classList.add('bg-slate-900', 'text-white');

      const filter = btn.getAttribute('data-filter');

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          (card as HTMLElement).style.display = '';
          card.classList.remove('opacity-0', 'scale-95');
          card.classList.add('opacity-100', 'scale-100');
        } else {
          card.classList.add('opacity-0', 'scale-95');
          setTimeout(() => {
            (card as HTMLElement).style.display = 'none';
          }, 300);
        }
      });
    });
  });
</script>
