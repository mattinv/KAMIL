---
import type { Locale } from '../i18n/config';

interface Props {
  locale?: Locale;
}

const { locale = 'pl' } = Astro.props;
const en = locale === 'en';

interface Texture {
  name: string;
  description: string;
  image?: string;
  gradient?: string;
  pattern?: string;
}

const textures: Texture[] = [
  {
    name: en ? 'Architectural Concrete' : 'Beton Architektoniczny',
    description: en ? 'Raw, industrial character' : 'Surowy, industrialny charakter',
    image: '/images/textures/concrete.jpg',
  },
  {
    name: en ? 'Wood Imitation' : 'Imitacja Drewna',
    description: en ? 'Warmth of natural wood' : 'Ciepło naturalnego drewna',
    image: '/images/textures/wood.jpg',
  },
  {
    name: en ? 'Classic Plaster' : 'Tynk Klasyczny',
    description: en ? 'Timeless elegance' : 'Ponadczasowa elegancja',
    image: '/images/textures/plaster.jpg',
  },
  {
    name: en ? 'Natural Stone' : 'Kamień Naturalny',
    description: en ? 'Prestige and durability' : 'Prestiż i trwałość',
    image: '/images/textures/stone.jpg',
  },
  {
    name: en ? 'Lamb Texture Plaster' : 'Tynk Baranek',
    description: en ? 'Classic structural texture' : 'Klasyczna faktura strukturalna',
    image: '/images/textures/baranek.jpg',
  },
  {
    name: en ? 'HPL Panels' : 'Panele HPL',
    description: en ? 'Modernity and durability' : 'Nowoczesność i trwałość',
    image: '/images/textures/hpl.jpg',
  },
];
---

<section class="section-padding bg-white" id="o-nas">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-end mb-16">
      <div>
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-50 border border-orange-200 mb-6">
          <span class="text-orange-600 text-sm font-semibold">{en ? 'Materials & Textures' : 'Materiały & Faktury'}</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
          {en ? 'Choose the perfect' : 'Wybierz idealną'}<br />
          <span class="text-gradient">{en ? 'facade texture' : 'fakturę elewacji'}</span>
        </h2>
      </div>
      <p class="text-lg text-slate-500 leading-relaxed">
        {en
          ? 'We offer a wide selection of facade textures and finishes. From raw architectural concrete to warm wood imitation — we will match the material to the character of your building.'
          : 'Oferujemy szeroki wybór faktur i wykończeń elewacji. Od surowego betonu architektonicznego po ciepłą imitację drewna — dopasujemy materiał do charakteru Twojego budynku.'}
      </p>
    </div>

    <!-- Texture Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 lg:gap-6">
      {textures.map((texture) => (
        <button
          class="texture-swatch group relative aspect-square rounded-2xl overflow-hidden cursor-pointer border-2 border-transparent hover:border-orange-500 transition-all duration-300 hover:shadow-xl"
          data-texture={texture.name}
        >
          <!-- Texture visual -->
          {texture.image ? (
            <img src={texture.image} alt={texture.name} class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          ) : (
            <>
              <div class={`absolute inset-0 ${texture.pattern} ${texture.gradient}`}></div>
              <div class="absolute inset-0 opacity-20 mix-blend-overlay" style="background-image: url('data:image/svg+xml;charset=utf-8,%3Csvg%20viewBox%3D%220%200%20256%20256%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cfilter%20id%3D%22noise%22%3E%3CfeTurbulence%20baseFrequency%3D%220.9%22%20numOctaves%3D%224%22%20stitchTiles%3D%22stitch%22%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D%22100%25%22%20height%3D%22100%25%22%20filter%3D%22url(%23noise)%22%20opacity%3D%220.4%22%2F%3E%3C%2Fsvg%3E');"></div>
            </>
          )}

          <!-- Label -->
          <div class="absolute inset-x-0 bottom-0 p-4 bg-gradient-to-t from-black/70 to-transparent translate-y-full group-hover:translate-y-0 transition-transform duration-300">
            <p class="text-white font-bold text-sm">{texture.name}</p>
            <p class="text-white/70 text-xs mt-0.5">{texture.description}</p>
          </div>

          <!-- Check indicator for selected state -->
          <div class="absolute top-3 right-3 w-8 h-8 rounded-full bg-orange-500 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 scale-75 group-hover:scale-100">
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
        </button>
      ))}
    </div>

    <!-- Selected texture display -->
    <div id="texture-info" class="mt-8 text-center">
      <p class="text-slate-400 text-sm">{en ? 'Click on a texture to see details' : 'Kliknij na fakturę, aby zobaczyć szczegóły'}</p>
    </div>
  </div>
</section>

<script>
  const swatches = document.querySelectorAll('.texture-swatch');
  const info = document.getElementById('texture-info');

  swatches.forEach((swatch) => {
    swatch.addEventListener('click', () => {
      // Remove active state from all
      swatches.forEach((s) => s.classList.remove('border-orange-500', 'shadow-xl', 'scale-[1.02]'));
      // Add active to clicked
      swatch.classList.add('border-orange-500', 'shadow-xl', 'scale-[1.02]');

      const name = swatch.getAttribute('data-texture');
      if (info) {
        info.innerHTML = `<p class="text-orange-500 font-semibold">Wybrano: ${name}</p><p class="text-slate-400 text-sm mt-1">Skontaktuj się z nami, aby otrzymać próbkę materiału</p>`;
      }
    });
  });
</script>
