---
---

<section id="kontakt" class="section-padding bg-slate-50">
  <div class="max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">
      <!-- Left: Info -->
      <div class="space-y-8">
        <div>
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-50 border border-orange-200 mb-6">
            <span class="text-orange-600 text-sm font-semibold">Kontakt</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
            Porozmawiajmy o<br />
            <span class="text-gradient">Twoim projekcie</span>
          </h2>
          <p class="mt-6 text-lg text-slate-500 leading-relaxed">
            Skontaktuj się z nami, aby otrzymać bezpłatną wycenę.
            Odpowiadamy w ciągu 24 godzin.
          </p>
        </div>

        <!-- Contact details -->
        <div class="space-y-5">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-orange-50 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-slate-900">Telefon</p>
              <p class="text-slate-500"><a href="tel:+48515156233" class="hover:text-red-500 transition-colors">515-156-233</a></p>
              <p class="text-slate-500"><a href="tel:+48515156233" class="hover:text-red-500 transition-colors">515-156-233</a></p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-orange-50 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-slate-900">Email</p>
              <p class="text-slate-500"><a href="mailto:kamilttage@gmail.com" class="hover:text-red-500 transition-colors">kamilttage@gmail.com</a></p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-orange-50 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-slate-900">Adres</p>
              <p class="text-slate-500">Kobierzyńska 103/5<br />30-382 Kraków</p>
              <p class="text-slate-400 text-sm mt-1">NIP: 6762421312</p>
            </div>
          </div>
        </div>

        <!-- Working hours -->
        <div class="p-6 bg-white rounded-2xl border border-slate-100">
          <p class="font-semibold text-slate-900 mb-3">Godziny pracy</p>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-slate-500">Poniedziałek - Piątek</span>
              <span class="text-slate-900 font-medium">7:00 - 17:00</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">Sobota</span>
              <span class="text-slate-900 font-medium">8:00 - 14:00</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">Niedziela</span>
              <span class="text-slate-400 font-medium">Zamknięte</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Form -->
      <div>
        <form class="bg-white rounded-2xl border border-slate-100 shadow-xl shadow-slate-900/5 p-8 space-y-6">
          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-semibold text-slate-700 mb-2">Imię i Nazwisko</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Jan Kowalski"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-slate-700 mb-2">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="jan@example.pl"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all"
              />
            </div>
          </div>

          <div>
            <label for="phone" class="block text-sm font-semibold text-slate-700 mb-2">Telefon</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder="+48 123 456 789"
              class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all"
            />
          </div>

          <div>
            <label for="type" class="block text-sm font-semibold text-slate-700 mb-2">Typ Inwestycji</label>
            <select
              id="type"
              name="type"
              class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all"
            >
              <option value="">Wybierz typ...</option>
              <option value="dom">Dom Jednorodzinny</option>
              <option value="wielorodzinny">Budynek Wielorodzinny</option>
              <option value="komercyjny">Obiekt Komercyjny</option>
              <option value="publiczny">Obiekt Użyteczności Publicznej</option>
              <option value="inny">Inny</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-slate-700 mb-2">Wiadomość</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Opisz swój projekt — metraż, lokalizacja, zakres prac..."
              class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-4 bg-red-600 hover:bg-red-500 text-white font-bold text-lg rounded-xl transition-all duration-300 hover:shadow-lg hover:shadow-red-600/25 hover:-translate-y-0.5 active:translate-y-0"
          >
            Wyślij Zapytanie
          </button>

          <p class="text-center text-xs text-slate-400">
            Odpowiadamy w ciągu 24h. Twoje dane są bezpieczne.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>
