<script>
  // Toggle between fast/detailed quote
  const btnFast = document.getElementById('btn-fast');
  const btnDetailed = document.getElementById('btn-detailed');
  const detailedSection = document.getElementById('detailed-section');

  function setMode(mode: string) {
    if (mode === 'fast') {
      btnFast?.classList.add('bg-red-600', 'text-white', 'shadow-sm');
      btnFast?.classList.remove('text-slate-500');
      btnDetailed?.classList.remove('bg-red-600', 'text-white', 'shadow-sm');
      btnDetailed?.classList.add('text-slate-500');
      detailedSection?.classList.add('hidden');
    } else {
      btnDetailed?.classList.add('bg-red-600', 'text-white', 'shadow-sm');
      btnDetailed?.classList.remove('text-slate-500');
      btnFast?.classList.remove('bg-red-600', 'text-white', 'shadow-sm');
      btnFast?.classList.add('text-slate-500');
      detailedSection?.classList.remove('hidden');
    }
  }

  btnFast?.addEventListener('click', () => setMode('fast'));
  btnDetailed?.addEventListener('click', () => setMode('detailed'));
</script>
