---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Kontakt — Darmowa Wycena Elewacji w 24h"
  description="Skontaktuj się z Elewacje z Klasą — bezpłatna wycena elewacji i ociepleń. Formularz wyceny online, doradztwo techniczne, pomoc z programem Czyste Powietrze."
  schemaType="contact"
>
  <!-- Hero -->
  <section class="relative pt-32 pb-16 bg-slate-900 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/projects/osiedle-front.jpg" alt="Osiedle domów z elewacją — kontakt Elewacje z Klasą" class="w-full h-full object-cover opacity-10" />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900/80 via-slate-900/95 to-slate-900"></div>
    </div>
    <div class="absolute top-0 left-0 w-full h-1.5 bg-red-600"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-500/10 border border-orange-500/20 mb-6">
        <span class="text-orange-400 text-sm font-semibold">Kontakt & Wycena</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight">
        Bezpłatna <span class="text-gradient">Wycena</span>
      </h1>
      <p class="mt-6 text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Wypełnij formularz, a przygotujemy szczegółową wycenę w ciągu 24 godzin.
        Im więcej szczegółów podasz, tym dokładniejsza będzie oferta.
      </p>

      <!-- Contact quick info -->
      <div class="flex flex-wrap justify-center gap-6 mt-10">
        <a href="tel:+48515156233" class="flex items-center gap-3 px-5 py-3 bg-white/5 border border-white/10 rounded-xl hover:bg-white/10 transition-colors">
          <svg class="w-5 h-5 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="text-white font-medium">515-156-233</span>
        </a>
        <a href="mailto:biuro@elewacjezklasa.pl" class="flex items-center gap-3 px-5 py-3 bg-white/5 border border-white/10 rounded-xl hover:bg-white/10 transition-colors">
          <svg class="w-5 h-5 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="text-white font-medium">biuro@elewacjezklasa.pl</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Form -->
  <section class="section-padding bg-slate-50">
    <div class="max-w-4xl mx-auto">
      <!-- Quote type toggle -->
      <div class="flex justify-center mb-12">
        <div class="inline-flex bg-white rounded-xl border border-slate-200 p-1.5 shadow-sm">
          <button id="btn-fast" class="quote-toggle px-6 py-3 text-sm font-semibold rounded-lg transition-all bg-red-600 text-white shadow-sm" data-mode="fast">
            Szybka Wycena
          </button>
          <button id="btn-detailed" class="quote-toggle px-6 py-3 text-sm font-semibold rounded-lg transition-all text-slate-500 hover:text-slate-700" data-mode="detailed">
            Szczegółowa Konsultacja
          </button>
        </div>
      </div>

      <form
        id="contact-form"
        action="https://formsubmit.co/biuro@elewacjezklasa.pl"
        method="POST"
        enctype="multipart/form-data"
        class="bg-white rounded-3xl border border-slate-100 shadow-xl shadow-slate-900/5 p-8 lg:p-12 space-y-10"
      >
        <!-- FormSubmit config -->
        <input type="hidden" name="_subject" value="Nowe zapytanie — Elewacje z Klasą" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="text" name="_honey" style="display:none" />

        <!-- Section 1: Contact Info -->
        <div>
          <h2 class="text-lg font-bold text-slate-900 mb-1">Dane kontaktowe</h2>
          <p class="text-sm text-slate-400 mb-6">Jak możemy się z Tobą skontaktować?</p>
          <div class="grid sm:grid-cols-3 gap-5">
            <div>
              <label for="name" class="block text-sm font-semibold text-slate-700 mb-2">Imię i Nazwisko *</label>
              <input type="text" id="name" name="Imię i Nazwisko" required placeholder="Jan Kowalski"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-semibold text-slate-700 mb-2">Telefon *</label>
              <input type="tel" id="phone" name="Telefon" required placeholder="+48 515 156 233"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all" />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-slate-700 mb-2">Email *</label>
              <input type="email" id="email" name="Email" required placeholder="jan@example.pl"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all" />
            </div>
          </div>
        </div>

        <hr class="border-slate-100" />

        <!-- Section 2: Basic Project Info -->
        <div>
          <h2 class="text-lg font-bold text-slate-900 mb-1">Informacje o projekcie</h2>
          <p class="text-sm text-slate-400 mb-6">Podstawowe dane do wyceny.</p>

          <!-- Investment Type - Segmented Control -->
          <div class="mb-6">
            <label class="block text-sm font-semibold text-slate-700 mb-3">Typ inwestycji *</label>
            <div class="grid grid-cols-3 gap-3">
              {['Dom jednorodzinny', 'Obiekt komercyjny', 'Budynek wielorodzinny'].map((type) => (
                <label class="invest-type relative cursor-pointer">
                  <input type="radio" name="Typ inwestycji" value={type} class="sr-only peer" required />
                  <div class="px-4 py-3.5 rounded-xl border-2 border-slate-200 text-center text-sm font-medium text-slate-600 peer-checked:border-red-500 peer-checked:bg-red-50 peer-checked:text-red-700 hover:border-slate-300 transition-all">
                    {type}
                  </div>
                </label>
              ))}
            </div>
          </div>

          <div class="mb-6">
            <label for="service-type" class="block text-sm font-semibold text-slate-700 mb-2">Rodzaj usługi *</label>
            <select id="service-type" name="Rodzaj usługi" required
              class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all">
              <option value="">Wybierz usługę...</option>
              <option value="Ocieplenie (ETICS)">Ocieplenie (ETICS)</option>
              <option value="Elewacja wentylowana">Elewacja wentylowana</option>
              <option value="Tynki dekoracyjne">Tynki dekoracyjne</option>
              <option value="Mycie i czyszczenie elewacji">Mycie i czyszczenie elewacji</option>
              <option value="Projekt komercyjny">Projekt komercyjny</option>
              <option value="Doradztwo i wizualizacja 3D">Doradztwo i wizualizacja 3D</option>
              <option value="Inne">Inne</option>
            </select>
          </div>

          <div class="grid sm:grid-cols-3 gap-5">
            <div>
              <label for="location" class="block text-sm font-semibold text-slate-700 mb-2">Lokalizacja *</label>
              <input type="text" id="location" name="Lokalizacja" required placeholder="Miasto lub kod pocztowy"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all" />
            </div>
            <div>
              <label for="area" class="block text-sm font-semibold text-slate-700 mb-2">Powierzchnia elewacji (m²) *</label>
              <input type="number" id="area" name="Powierzchnia m2" required placeholder="np. 200"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all" />
            </div>
            <div>
              <label for="status" class="block text-sm font-semibold text-slate-700 mb-2">Status budynku</label>
              <select id="status" name="Status budynku"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all">
                <option value="">Wybierz...</option>
                <option value="Nowa budowa">Nowa budowa</option>
                <option value="Renowacja istniejącego">Renowacja istniejącego budynku</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Section 3: Technical Parameters (detailed mode) -->
        <div id="detailed-section" class="hidden">
          <hr class="border-slate-100 mb-10" />
          <div>
            <h2 class="text-lg font-bold text-slate-900 mb-1">Parametry techniczne</h2>
            <p class="text-sm text-slate-400 mb-6">Precyzyjne dane dla dokładnej wyceny.</p>

            <div class="grid sm:grid-cols-3 gap-5 mb-6">
              <div>
                <label for="insulation" class="block text-sm font-semibold text-slate-700 mb-2">Materiał izolacyjny</label>
                <select id="insulation" name="Materiał izolacyjny"
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all">
                  <option value="">Wybierz...</option>
                  <option value="Styropian grafitowy">Styropian grafitowy</option>
                  <option value="Wełna mineralna">Wełna mineralna</option>
                  <option value="PIR / Płyty specjalne">PIR / Płyty specjalne</option>
                  <option value="Nie wiem — potrzebuję doradztwa">Nie wiem — potrzebuję doradztwa</option>
                </select>
              </div>
              <div>
                <label for="thickness" class="block text-sm font-semibold text-slate-700 mb-2">Grubość izolacji</label>
                <select id="thickness" name="Grubość izolacji"
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all">
                  <option value="">Wybierz...</option>
                  <option value="15 cm">15 cm</option>
                  <option value="20 cm">20 cm</option>
                  <option value="25 cm+">25 cm+</option>
                  <option value="Do ustalenia">Do ustalenia z doradcą</option>
                </select>
              </div>
              <div>
                <label for="finish" class="block text-sm font-semibold text-slate-700 mb-2">Wykończenie / Tynk</label>
                <select id="finish" name="Wykończenie"
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all">
                  <option value="">Wybierz...</option>
                  <option value="Tynk silikonowy">Tynk silikonowy (standard)</option>
                  <option value="Tynk silikatowo-silikonowy">Tynk silikatowo-silikonowy</option>
                  <option value="Beton architektoniczny">Efekt betonu architektonicznego</option>
                  <option value="Deska elewacyjna">Imitacja drewna (deska elewacyjna)</option>
                  <option value="Fasada wentylowana">Fasada wentylowana</option>
                </select>
              </div>
            </div>

            <!-- Premium options -->
            <div class="mb-6">
              <label class="block text-sm font-semibold text-slate-700 mb-3">Elementy dekoracyjne</label>
              <div class="grid sm:grid-cols-2 gap-3">
                {[
                  'Profile i sztukaterie architektoniczne',
                  'Integracja oświetlenia LED',
                  'Okładzina kamienna / kwarcowa',
                  'Panele HPL',
                ].map((item) => (
                  <label class="flex items-center gap-3 px-4 py-3 rounded-xl border border-slate-200 hover:border-slate-300 cursor-pointer transition-all has-[:checked]:border-red-500 has-[:checked]:bg-red-50">
                    <input type="checkbox" name="Elementy dekoracyjne" value={item} class="w-4 h-4 text-red-600 rounded border-slate-300 focus:ring-red-500" />
                    <span class="text-sm text-slate-700">{item}</span>
                  </label>
                ))}
              </div>
            </div>

            <!-- Brand preference -->
            <div class="mb-6">
              <label for="brand" class="block text-sm font-semibold text-slate-700 mb-2">Preferowany system / marka (opcjonalnie)</label>
              <select id="brand" name="Preferowana marka"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all">
                <option value="">Bez preferencji</option>
                <option value="Sto">Sto</option>
                <option value="Weber">Weber (Saint-Gobain)</option>
                <option value="Caparol">Caparol</option>
                <option value="Baumit">Baumit</option>
                <option value="Atlas">Atlas</option>
                <option value="Ceresit">Ceresit</option>
              </select>
            </div>

            <!-- Additional work -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-3">Dodatkowe prace</label>
              <div class="grid sm:grid-cols-3 gap-3">
                {[
                  'Parapety zewnętrzne',
                  'Wykończenie cokołu',
                  'Podbitka dachowa',
                ].map((item) => (
                  <label class="flex items-center gap-3 px-4 py-3 rounded-xl border border-slate-200 hover:border-slate-300 cursor-pointer transition-all has-[:checked]:border-red-500 has-[:checked]:bg-red-50">
                    <input type="checkbox" name="Dodatkowe prace" value={item} class="w-4 h-4 text-red-600 rounded border-slate-300 focus:ring-red-500" />
                    <span class="text-sm text-slate-700">{item}</span>
                  </label>
                ))}
              </div>
            </div>
          </div>

          <hr class="border-slate-100 mt-10 mb-10" />

          <!-- Section 4: Czyste Powietrze -->
          <div>
            <h2 class="text-lg font-bold text-slate-900 mb-1">
              Program „Czyste Powietrze"
              <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700">Dotacja</span>
            </h2>
            <p class="text-sm text-slate-400 mb-6">Pomagamy w uzyskaniu dofinansowania z programu rządowego.</p>

            <div class="grid sm:grid-cols-3 gap-5 mb-6">
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-3">Czy ubiegasz się o dotację?</label>
                <div class="flex gap-3">
                  <label class="flex-1 cursor-pointer">
                    <input type="radio" name="Czyste Powietrze" value="Tak" class="sr-only peer" />
                    <div class="px-4 py-3 rounded-xl border-2 border-slate-200 text-center text-sm font-medium text-slate-600 peer-checked:border-green-500 peer-checked:bg-green-50 peer-checked:text-green-700 hover:border-slate-300 transition-all">
                      Tak
                    </div>
                  </label>
                  <label class="flex-1 cursor-pointer">
                    <input type="radio" name="Czyste Powietrze" value="Nie" class="sr-only peer" />
                    <div class="px-4 py-3 rounded-xl border-2 border-slate-200 text-center text-sm font-medium text-slate-600 peer-checked:border-slate-400 peer-checked:bg-slate-50 peer-checked:text-slate-700 hover:border-slate-300 transition-all">
                      Nie
                    </div>
                  </label>
                </div>
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-3">Pomoc z dokumentacją?</label>
                <div class="flex gap-3">
                  <label class="flex-1 cursor-pointer">
                    <input type="radio" name="Pomoc z dokumentacją" value="Tak" class="sr-only peer" />
                    <div class="px-4 py-3 rounded-xl border-2 border-slate-200 text-center text-sm font-medium text-slate-600 peer-checked:border-green-500 peer-checked:bg-green-50 peer-checked:text-green-700 hover:border-slate-300 transition-all">
                      Tak
                    </div>
                  </label>
                  <label class="flex-1 cursor-pointer">
                    <input type="radio" name="Pomoc z dokumentacją" value="Nie" class="sr-only peer" />
                    <div class="px-4 py-3 rounded-xl border-2 border-slate-200 text-center text-sm font-medium text-slate-600 peer-checked:border-slate-400 peer-checked:bg-slate-50 peer-checked:text-slate-700 hover:border-slate-300 transition-all">
                      Nie
                    </div>
                  </label>
                </div>
              </div>
              <div>
                <label for="building-year" class="block text-sm font-semibold text-slate-700 mb-2">Rok budowy budynku</label>
                <input type="number" id="building-year" name="Rok budowy" placeholder="np. 1985" min="1900" max="2026"
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all" />
              </div>
            </div>
          </div>

          <hr class="border-slate-100 mt-10 mb-10" />

          <!-- Section 5: File Upload -->
          <div>
            <h2 class="text-lg font-bold text-slate-900 mb-1">Załączniki</h2>
            <p class="text-sm text-slate-400 mb-6">Projekt architektoniczny lub zdjęcia budynku zwiększają dokładność wyceny o ~20%.</p>

            <label class="block cursor-pointer">
              <div class="border-2 border-dashed border-slate-200 rounded-2xl p-8 text-center hover:border-orange-400 hover:bg-orange-50/30 transition-all">
                <svg class="w-10 h-10 text-slate-300 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                </svg>
                <p class="text-sm font-semibold text-slate-600">Przeciągnij pliki lub kliknij, aby wybrać</p>
                <p class="text-xs text-slate-400 mt-1">PDF, JPG, PNG — maks. 10 MB</p>
              </div>
              <input type="file" name="attachment" multiple accept=".pdf,.jpg,.jpeg,.png" class="sr-only" />
            </label>
          </div>
        </div>

        <hr class="border-slate-100" />

        <!-- Message -->
        <div>
          <label for="message" class="block text-sm font-semibold text-slate-700 mb-2">Wiadomość / Uwagi</label>
          <textarea id="message" name="Wiadomość" rows="4" placeholder="Opisz swój projekt, oczekiwania, termin realizacji..."
            class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all resize-none"></textarea>
        </div>

        <!-- Submit -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-xs text-slate-400 max-w-sm">
            Wysyłając formularz, wyrażasz zgodę na przetwarzanie danych w celu przygotowania wyceny.
            Odpowiadamy w ciągu 24h.
          </p>
          <button type="submit" id="submit-btn"
            class="w-full sm:w-auto px-10 py-4 bg-red-600 hover:bg-red-500 text-white font-bold text-lg rounded-xl transition-all duration-300 hover:shadow-lg hover:shadow-red-600/25 hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-3">
            <span>Wyślij Zapytanie</span>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </button>
        </div>
      </form>

      <!-- Success message (hidden by default) -->
      <div id="success-msg" class="hidden mt-8 p-8 bg-green-50 border border-green-200 rounded-2xl text-center">
        <svg class="w-12 h-12 text-green-500 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-xl font-bold text-green-800">Wiadomość wysłana!</h3>
        <p class="text-green-600 mt-2">Dziękujemy za zapytanie. Skontaktujemy się w ciągu 24 godzin.</p>
      </div>
    </div>
  </section>

  <!-- Map / Location -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-slate-50 rounded-2xl p-8 text-center">
          <svg class="w-8 h-8 text-red-500 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <h3 class="font-bold text-slate-900">Obszar działania</h3>
          <p class="text-slate-500 text-sm mt-2">Małopolska i okolice<br/>Cała Polska dla większych projektów</p>
        </div>
        <div class="bg-slate-50 rounded-2xl p-8 text-center">
