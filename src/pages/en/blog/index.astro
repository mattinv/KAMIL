---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const enPosts = allPosts.filter((p) => p.id.startsWith('en/'));
const sortedPosts = enPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const featuredPosts = sortedPosts.filter(p => p.data.featured);
const categories = [
  { value: 'all', label: 'All' },
  { value: 'ocieplenia', label: 'Insulation' },
  { value: 'elewacje', label: 'Facades' },
  { value: 'materialy', label: 'Materials' },
  { value: 'dotacje', label: 'Subsidies' },
  { value: 'porady', label: 'Tips' },
];
---

<Layout
  title="Facade Knowledge Hub — Insulation & Facade Guides"
  description="Practical advice on insulation, facades, building materials, and subsidies. Elewacje z Klasa experts share their knowledge."
  schemaType="blog"
  locale="en"
>
  <!-- Hero -->
  <section class="relative pt-32 pb-20 bg-slate-900 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute top-1/4 left-0 w-96 h-96 bg-orange-500/10 rounded-full blur-[128px]"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-500/10 border border-red-500/20 mb-6">
        <svg class="w-4 h-4 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <span class="text-orange-400 text-sm font-semibold">Knowledge Hub</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight">
        Facade <span class="text-gradient">Knowledge Hub</span>
      </h1>
      <p class="mt-6 text-lg text-slate-400 max-w-2xl leading-relaxed">
        Practical knowledge about insulation, facades, and building materials.
        We answer the questions our clients ask before starting work.
      </p>
    </div>
  </section>

  <!-- Featured Articles -->
  {featuredPosts.length > 0 && (
    <section class="section-padding bg-white">
      <div class="max-w-7xl mx-auto">
        <p class="text-sm font-semibold text-orange-500 uppercase tracking-wider mb-6">Featured articles</p>
        <div class="grid md:grid-cols-2 gap-8">
          {featuredPosts.slice(0, 2).map((post) => (
            <a href={`/en/blog/${post.id.replace('en/', '')}`} class="group block rounded-2xl border border-slate-100 bg-slate-50 hover:bg-red-50/50 hover:border-red-200 overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-900/5">
              <div class="p-8">
                <div class="flex items-center gap-3 mb-4">
                  <span class="px-3 py-1 bg-red-600 text-xs font-bold text-white rounded-lg">Featured</span>
                  <span class="px-3 py-1 bg-white text-xs font-semibold text-slate-500 rounded-lg border border-slate-200">{post.data.categoryLabel}</span>
                </div>
                <h2 class="text-2xl font-bold text-slate-900 group-hover:text-red-600 transition-colors leading-tight">
                  {post.data.title}
                </h2>
                <p class="mt-3 text-slate-500 line-clamp-3">{post.data.description}</p>
                <div class="mt-6 flex items-center justify-between">
                  <div class="flex items-center gap-4 text-xs text-slate-400">
                    <span>{post.data.date}</span>
                    <span>{post.data.readingTime} read</span>
                  </div>
                  <span class="inline-flex items-center gap-1 text-sm font-semibold text-red-600">
                    Read
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- All Articles -->
  <section class="section-padding bg-slate-50">
    <div class="max-w-7xl mx-auto">
      <!-- Category Filter -->
      <div class="flex flex-wrap justify-center gap-2 mb-12">
        {categories.map((cat, i) => (
          <button
            class:list={[
              'blog-filter px-5 py-2 rounded-xl text-sm font-semibold transition-all duration-300',
              i === 0 ? 'bg-slate-900 text-white' : 'bg-white text-slate-600 border border-slate-200 hover:border-slate-300',
            ]}
            data-filter={cat.value}
          >
            {cat.label}
            {cat.value === 'all'
              ? ` (${sortedPosts.length})`
              : ` (${sortedPosts.filter(p => p.data.category === cat.value).length})`
            }
          </button>
        ))}
      </div>

      <!-- Articles Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedPosts.map((post) => (
          <article
            class="blog-card group rounded-2xl border border-slate-100 bg-white hover:shadow-xl hover:shadow-slate-900/5 transition-all duration-500 hover:-translate-y-1 overflow-hidden"
            data-category={post.data.category}
          >
            <a href={`/en/blog/${post.id.replace('en/', '')}`} class="block p-6">
              <div class="flex items-center gap-3 mb-4">
                <span class="px-3 py-1 bg-slate-100 text-xs font-semibold text-slate-600 rounded-lg">
                  {post.data.categoryLabel}
                </span>
                <span class="text-xs text-slate-400">{post.data.readingTime} read</span>
              </div>

              <h2 class="text-xl font-bold text-slate-900 group-hover:text-red-600 transition-colors leading-tight">
                {post.data.title}
              </h2>
              <p class="mt-3 text-sm text-slate-500 line-clamp-3">{post.data.description}</p>

              <div class="mt-5 flex items-center justify-between">
                <span class="text-xs text-slate-400">{post.data.date}</span>
                <span class="inline-flex items-center gap-1 text-sm font-semibold text-red-600">
                  Read more
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-slate-900 text-center">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Have questions about <span class="text-gradient">insulation?</span>
      </h2>
      <p class="mt-4 text-lg text-slate-400">
        Contact us — we are happy to advise and prepare a free quote.
      </p>
      <a
        href="/en/contact"
        class="inline-flex items-center gap-3 mt-8 px-8 py-4 bg-red-600 hover:bg-red-500 text-white font-bold text-lg rounded-xl transition-all duration-300 hover:shadow-2xl hover:shadow-red-600/25"
      >
        Free Quote
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </section>
</Layout>

<script>
  const filterBtns = document.querySelectorAll('.blog-filter');
  const cards = document.querySelectorAll('.blog-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-slate-900', 'text-white');
        b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      });
      btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      btn.classList.add('bg-slate-900', 'text-white');

      const filter = btn.getAttribute('data-filter');

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
