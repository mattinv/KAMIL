---
import Layout from '../../../layouts/Layout.astro';
import Partners from '../../../components/Partners.astro';

const services = [
  {
    id: 'etics',
    title: 'Insulation Systems (ETICS)',
    subtitle: 'Wet render method',
    description: 'Comprehensive building insulation using the wet render method. We use certified Weber, Baumit, Caparol, and Atlas systems with full manufacturer warranty. ETICS is the most commonly chosen method of thermal modernization in Poland — combining thermal insulation with aesthetic facade finishing.',
    image: '/images/projects/dom-ocieplenie-styropian.jpg',
    features: [
      'EPS 70/80 polystyrene — construction standard',
      'Graphite polystyrene — 20% better lambda coefficient',
      'XPS polystyrene — base and foundation insulation',
      'Mineral wool — non-combustible, vapor-permeable',
      'Silicone, silicate, and acrylic plasters',
      'A+ energy class after insulation',
    ],
    process: ['Building audit and measurement', 'System and material selection', 'Substrate preparation', 'Insulation bonding and anchoring', 'Reinforcement mesh embedding', 'Priming and plastering', 'Painting and details'],
  },
  {
    id: 'wentylowane',
    title: 'Ventilated Facades',
    subtitle: 'Modern cladding systems',
    description: 'Modern ventilated facades with HPL panels, fiber-cement, and aluminum cladding. The ventilated facade system provides excellent thermal and acoustic insulation with durability exceeding 50 years. Ideal for commercial buildings and prestigious residences where durability and prestige matter.',
    image: '/images/projects/kamienica-front.jpg',
    features: [
      'HPL panels (Trespa, Fundermax)',
      'Fiber-cement panels (Equitone, Cedral)',
      'Composite aluminum panels',
      'Large-format ceramic cladding',
      'Aluminum or steel substructure',
      'Ventilated air gap',
    ],
    process: ['Technical facade design', 'Substructure installation', 'Wool thermal insulation', 'Windproof membrane', 'Cladding installation', 'Detail and attic finishing'],
  },
  {
    id: 'tynki',
    title: 'Decorative & Structural Plasters',
    subtitle: 'Facade finishing',
    description: 'Wide selection of decorative and structural plasters for facade finishing. From classic lamb and bark beetle textures, through modeled plasters, to architectural concrete effects. We match texture and color to the character of the building.',
    image: '/images/projects/dom-szary-flaga.jpg',
    features: [
      'Lamb plaster — classic texture',
      'Bark beetle plaster — structural pattern',
      'Silicone plaster — self-cleaning',
      'Silicate plaster — vapor-permeable',
      'Mosaic plaster — base and details',
      'Architectural concrete effect',
    ],
    process: ['Texture and color selection', 'Facade visualization', 'Substrate preparation', 'Priming', 'Plaster application', 'Structure forming'],
  },
  {
    id: 'komercyjne',
    title: 'Commercial Projects',
    subtitle: 'For developers and investors',
    description: 'Projects for developers, investors, and the public sector. Office buildings, halls, shopping centers, and multi-family buildings. We offer complete investment support — from facade design, through execution, to as-built documentation.',
    image: '/images/projects/budynek-wielorodzinny.jpg',
    features: [
      'Multi-family buildings and housing estates',
      'Office and retail buildings',
      'Industrial and warehouse halls',
      'Public utility buildings',
      'Comprehensive documentation',
      'Warranty service',
    ],
    process: ['Project and documentation analysis', 'Pricing and scheduling', 'Scaffolding installation', 'Facade work execution', 'Quality control', 'Handover and documentation'],
  },
  {
    id: 'mycie',
    title: 'Facade Cleaning & Washing',
    subtitle: 'Restoring a fresh look',
    description: 'Professional cleaning of residential and commercial building facades. We remove biological contamination (algae, moss, fungi), atmospheric deposits, graffiti stains, and urban pollution. We use pressure washing, chemical cleaning, and gentle methods for wooden and brick facades.',
    image: '/images/projects/mycie-elewacji.jpg',
    features: [
      'Pressure washing (Karcher)',
      'Algae, moss, and fungi removal',
      'Chemical cleaning of contamination',
      'Graffiti and marking removal',
      'Hydrophobic impregnation after washing',
      'Multi-family building and hall washing',
    ],
    process: ['Facade condition assessment', 'Cleaning method selection', 'Window and surroundings protection', 'Facade washing', 'Protective impregnation', 'Handover and inspection'],
  },
  {
    id: 'doradztwo',
    title: 'Expert Consulting',
    subtitle: 'Visualizations and design',
    description: 'Professional consulting on material selection, color schemes, and facade systems. We prepare 3D facade visualizations so you can see the final result before work begins.',
    image: '/images/projects/osiedle-front.jpg',
    features: [
      '3D facade visualizations',
      'Color and material selection',
      'Technical substrate analysis',
      'Energy consulting',
      'Cost estimate and schedule',
      'Subsidy application assistance',
    ],
    process: ['On-site inspection', 'Measurement and documentation', 'Color design', '3D visualization', 'Material and labor pricing', 'Presentation and approval'],
  },
];

const iconPaths: Record<string, string> = {
  etics: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
  wentylowane: 'M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z',
  tynki: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
  komercyjne: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  mycie: 'M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z',
  doradztwo: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
};
---

<Layout
  title="Facade & Insulation Services Krakow"
  description="Comprehensive facade services — ETICS insulation systems, ventilated facades, decorative plasters, commercial projects, and expert consulting with 3D visualizations."
  schemaType="services"
  locale="en"
>
  <!-- Page Hero -->
  <section class="relative pt-32 pb-20 bg-slate-900 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/projects/dom-parterowy.jpg" alt="Single-story house facade — facade services Krakow" class="w-full h-full object-cover opacity-15" />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900/80 via-slate-900/90 to-slate-900"></div>
    </div>
    <div class="absolute top-0 left-0 w-full h-1.5 bg-red-600"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-500/10 border border-orange-500/20 mb-6">
        <span class="text-orange-400 text-sm font-semibold">Services</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight">
        Our <span class="text-gradient">Services</span>
      </h1>
      <p class="mt-6 text-lg text-slate-400 max-w-2xl leading-relaxed">
        From insulation to ventilated facades — comprehensive facade project support for individual and commercial clients.
      </p>
    </div>
  </section>

  <!-- Quick Nav -->
  <section class="sticky top-20 z-30 bg-white/95 backdrop-blur-lg border-b border-slate-100 py-4">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex gap-2 overflow-x-auto scrollbar-hide">
        {services.map((s) => (
          <a
            href={`#${s.id}`}
            class="flex-shrink-0 px-4 py-2 text-sm font-medium text-slate-600 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all"
          >
            {s.title.split('(')[0].split('—')[0].trim()}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Service Sections -->
  {services.map((service, index) => (
    <section id={service.id} class={`section-padding ${index % 2 === 0 ? 'bg-white' : 'bg-slate-50'}`}>
      <div class="max-w-7xl mx-auto">
        <div class={`grid lg:grid-cols-2 gap-12 lg:gap-20 items-center ${index % 2 !== 0 ? 'lg:grid-flow-dense' : ''}`}>
          <!-- Image -->
          <div class={`relative ${index % 2 !== 0 ? 'lg:col-start-2' : ''}`}>
            <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-xl shadow-slate-900/10">
              <img
                src={service.image}
                alt={service.title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="absolute -bottom-4 -right-4 w-32 h-32 bg-orange-500/10 rounded-2xl blur-2xl -z-10"></div>
          </div>

          <!-- Content -->
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-slate-900 to-slate-700 flex items-center justify-center">
                <svg class="w-6 h-6 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[service.id]} />
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-orange-500 uppercase tracking-wider">{service.subtitle}</p>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">{service.title}</h2>
              </div>
            </div>

            <p class="text-slate-500 leading-relaxed">{service.description}</p>

            <!-- Features -->
            <div>
              <h3 class="text-sm font-bold text-slate-700 uppercase tracking-wider mb-4">What we offer</h3>
              <ul class="grid sm:grid-cols-2 gap-3">
                {service.features.map((f) => (
                  <li class="flex items-start gap-2.5 text-sm text-slate-600">
                    <svg class="w-4 h-4 text-red-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Process -->
            <div>
              <h3 class="text-sm font-bold text-slate-700 uppercase tracking-wider mb-4">Implementation stages</h3>
              <div class="flex flex-wrap gap-2">
                {service.process.map((step, i) => (
                  <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-slate-100 rounded-lg text-sm">
                    <span class="text-xs font-bold text-orange-500">{String(i + 1).padStart(2, '0')}</span>
                    <span class="text-slate-600">{step}</span>
                  </div>
                ))}
              </div>
            </div>

            <a
              href="/en/contact"
              class="inline-flex items-center gap-2 px-6 py-3 bg-red-600 hover:bg-red-500 text-white font-semibold rounded-xl transition-all duration-300 hover:shadow-lg hover:shadow-red-600/25"
            >
              Request a quote
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  ))}

  <Partners />

  <!-- Detailed Service Pages -->
  <section class="section-padding bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-sm font-semibold text-orange-500 uppercase tracking-wider mb-2">Learn more</p>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Detailed <span class="text-gradient">Service Guides</span>
        </h2>
        <p class="mt-4 text-slate-500 max-w-2xl mx-auto">
          Read detailed descriptions of our services — materials, process, costs, and frequently asked questions.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { href: '/en/services/house-insulation-krakow', title: 'House Insulation', desc: 'ETICS systems, polystyrene, wool — a complete guide to house insulation.' },
          { href: '/en/services/facades-krakow', title: 'Facades Krakow', desc: 'All facade services — from insulation to decorative plasters.' },
          { href: '/en/services/thermal-modernization-malopolska', title: 'Thermal Modernization', desc: 'Comprehensive energy modernization of buildings in Malopolska.' },
          { href: '/en/services/ventilated-facades-krakow', title: 'Ventilated Facades', desc: 'Modern HPL, fiber-cement, and aluminum facades.' },
          { href: '/en/services/silicone-plaster-facade', title: 'Silicone Plaster', desc: 'Self-cleaning silicone plaster — durable facade finishing.' },
          { href: '/en/services/tenement-facade-renovation', title: 'Tenement Renovation', desc: 'Historic facade restoration with conservation approvals.' },
          { href: '/en/services/graphite-polystyrene-insulation', title: 'Graphite Polystyrene', desc: '20% better insulation — thinner layer, better results.' },
          { href: '/en/services/mineral-wool-insulation', title: 'Mineral Wool', desc: 'Non-combustible A1 class insulation — vapor-permeable and acoustic.' },
          { href: '/en/services/3d-facade-visualization', title: '3D Visualization', desc: 'See the final result before facade work begins.' },
          { href: '/en/services/clean-air-program-facade', title: 'Clean Air Program', desc: 'Subsidy up to 135,000 PLN for insulation — we help from application to settlement.' },
          { href: '/en/services/facade-cleaning-krakow', title: 'Facade Cleaning', desc: 'Professional facade cleaning — algae, fungi, and contamination removal.' },
        ].map((item) => (
          <a href={item.href} class="group block p-6 rounded-2xl border border-slate-100 hover:border-red-200 bg-slate-50 hover:bg-red-50/50 transition-all duration-300">
            <h3 class="text-lg font-bold text-slate-900 group-hover:text-red-600 transition-colors">{item.title}</h3>
            <p class="mt-2 text-sm text-slate-500">{item.desc}</p>
            <span class="inline-flex items-center gap-1 mt-3 text-sm font-semibold text-red-600">
              Read more
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-slate-900 text-center">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Need a <span class="text-gradient">quote?</span>
      </h2>
      <p class="mt-4 text-lg text-slate-400">
        Contact us — free consultation and quote within 24 hours.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
        <a
          href="/en/contact"
          class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-red-600 hover:bg-red-500 text-white font-bold text-lg rounded-xl transition-all duration-300 hover:shadow-2xl hover:shadow-red-600/25"
        >
          Free Quote
        </a>
        <a href="tel:+48515156233" class="inline-flex items-center justify-center gap-3 px-8 py-4 border border-slate-600 hover:border-red-500/50 text-white font-semibold text-lg rounded-xl transition-all duration-300 hover:bg-white/5">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          515-156-233
        </a>
      </div>
    </div>
  </section>
</Layout>
