---
import Layout from '../../layouts/Layout.astro';
import Partners from '../../components/Partners.astro';
---

<Layout
  title="About Us — 15+ Years of Facade Experience"
  description="Meet Elewacje z Klasa — Kamil Ochalek's company specializing in professional facades and building insulation in Poland. Over 15 years of experience."
  schemaType="about"
  locale="en"
>
  <!-- Page Hero -->
  <section class="relative pt-32 pb-20 bg-slate-900 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/projects/dom-ocieplanie.jpg" alt="House insulation — Elewacje z Klasa during work" class="w-full h-full object-cover opacity-20" />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900/80 via-slate-900/90 to-slate-900"></div>
    </div>
    <div class="absolute top-0 left-0 w-full h-1.5 bg-red-600"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-500/10 border border-red-500/20 mb-6">
        <span class="text-orange-400 text-sm font-semibold">About Us</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight">
        Meet <span class="text-gradient">Elewacje z Klasa</span>
      </h1>
      <p class="mt-6 text-lg text-slate-400 max-w-2xl leading-relaxed">
        The people behind the company, our history, and the values that define every project we deliver.
      </p>
    </div>
  </section>

  <!-- Founder Section -->
  <section class="section-padding bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="relative">
          <div class="aspect-[4/5] rounded-3xl overflow-hidden bg-slate-100 relative">
            <img src="/images/kamil-ochalek.jpg" alt="Kamil Ochalek — founder of Elewacje z Klasa" class="w-full h-full object-cover object-top" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/40 to-transparent"></div>
          </div>
          <div class="absolute -bottom-6 -right-6 lg:right-8 bg-white rounded-2xl shadow-xl shadow-slate-900/10 border border-slate-100 p-6 max-w-[200px]">
            <p class="text-4xl font-extrabold text-red-600">15+</p>
            <p class="text-sm text-slate-500 font-medium mt-1">years of industry experience</p>
          </div>
          <div class="absolute -top-4 -left-4 w-24 h-24 bg-orange-500/20 rounded-2xl blur-2xl"></div>
        </div>

        <div class="space-y-6">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-50 border border-orange-200">
            <span class="text-orange-600 text-sm font-semibold">Founder</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
            Kamil Ochalek
          </h2>

          <p class="text-lg text-slate-500 leading-relaxed">
            A facade and insulation specialist with many years of experience in the construction industry.
            Founder of <strong class="text-slate-900">Elewacje z Klasa</strong>, which has been delivering
            facade projects for individual and commercial clients throughout Poland for years.
          </p>

          <p class="text-slate-500 leading-relaxed">
            A passion for architecture and commitment to the highest quality of workmanship are the foundations
            on which the company was built. Each project is treated individually — from expert consulting and
            visualization, through material selection, to precise execution and final inspection.
          </p>

          <p class="text-slate-500 leading-relaxed">
            I work with the best facade system manufacturers, which allows me to offer solutions that are
            durable, aesthetic, and energy-efficient. Quality guarantee and timeliness are not just a promise
            — they are the standard for every project.
          </p>

          <div class="flex flex-wrap gap-4 pt-4">
            <a href="tel:+48515156233" class="inline-flex items-center gap-2 px-5 py-2.5 bg-red-600 hover:bg-red-500 text-white font-semibold rounded-xl transition-all duration-300 hover:shadow-lg hover:shadow-red-600/25">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              515-156-233
            </a>
            <a href="https://www.linkedin.com/in/kamil-ochalek-231b482a9/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 border border-slate-200 hover:border-slate-300 text-slate-700 font-semibold rounded-xl transition-all duration-300 hover:bg-slate-50">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values / Why Us -->
  <section class="section-padding bg-slate-50">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-50 border border-orange-200 mb-6">
          <span class="text-orange-600 text-sm font-semibold">Why us</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
          What makes us <span class="text-gradient">stand out</span>
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {[
          {
            icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
            title: 'Quality Guarantee',
            description: '10-year warranty on completed work. We exclusively use certified materials and proven facade systems.',
          },
          {
            icon: 'M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z',
            title: '3D Visualizations',
            description: 'Before starting work, we prepare a facade visualization so you can see the final result even before construction begins.',
          },
          {
            icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
            title: 'Timeliness',
            description: 'We adhere to agreed deadlines. Precise work schedule and regular communication with the client.',
          },
          {
            icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
            title: 'Experienced Team',
            description: 'Skilled crew with many years of experience. We continuously improve our competencies and follow industry innovations.',
          },
        ].map((value) => (
          <div class="group bg-white rounded-2xl border border-slate-100 p-8 hover:shadow-xl hover:shadow-slate-900/5 transition-all duration-500 hover:-translate-y-1 text-center">
            <div class="w-14 h-14 rounded-xl bg-red-50 flex items-center justify-center mx-auto mb-6 group-hover:bg-red-600 transition-colors duration-300">
              <svg class="w-7 h-7 text-red-500 group-hover:text-white transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={value.icon} />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3">{value.title}</h3>
            <p class="text-slate-500 text-sm leading-relaxed">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process / How We Work -->
  <section class="section-padding bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-50 border border-orange-200 mb-6">
          <span class="text-orange-600 text-sm font-semibold">Process</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
          How we <span class="text-gradient">work</span>
        </h2>
        <p class="mt-6 text-lg text-slate-500">
          From first contact to handover — a transparent process at every stage.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 relative">
        <div class="hidden lg:block absolute top-16 left-[12.5%] right-[12.5%] h-0.5 bg-slate-100"></div>

        {[
          { step: '01', title: 'Consultation', description: 'A free discussion about your project. We discuss expectations, budget, and possibilities.' },
          { step: '02', title: 'Visualization', description: 'We prepare a facade visualization — you see the final result before work begins.' },
          { step: '03', title: 'Execution', description: 'Professional work by an experienced team while maintaining the schedule.' },
          { step: '04', title: 'Handover', description: 'Detailed inspection of completed work, documentation, and warranty on services performed.' },
        ].map((item) => (
          <div class="relative text-center">
            <div class="w-16 h-16 rounded-2xl bg-slate-900 flex items-center justify-center mx-auto mb-6 relative z-10">
              <span class="text-red-400 font-extrabold text-lg">{item.step}</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">{item.title}</h3>
            <p class="text-slate-500 text-sm leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Photo Gallery Strip -->
  <section class="py-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-9 gap-3 lg:gap-4">
        {[
          { src: '/images/projects/osiedle-front.jpg', alt: 'Housing estate' },
          { src: '/images/projects/dom-parterowy.jpg', alt: 'Single-story house' },
          { src: '/images/projects/kamienica-front.jpg', alt: 'City tenement' },
          { src: '/images/projects/dom-ciemny-asymetryczny.jpg', alt: 'Dark facade house' },
          { src: '/images/projects/blizniak-budowa.jpg', alt: 'Semi-detached' },
          { src: '/images/projects/kamienica-boczna.jpg', alt: 'Side tenement' },
          { src: '/images/projects/dom-ocieplenie-styropian.jpg', alt: 'House polystyrene insulation' },
          { src: '/images/projects/dom-szary-biel.jpg', alt: 'White-graphite house' },
          { src: '/images/projects/budynek-wielorodzinny.jpg', alt: 'Multi-family building' },
        ].map((img) => (
          <a href="/en/projects" class="aspect-square rounded-xl overflow-hidden">
            <img src={img.src} alt={img.alt} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <Partners />

  <!-- CTA -->
  <section class="section-padding bg-slate-900 text-center">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Ready for a <span class="text-gradient">new facade?</span>
      </h2>
      <p class="mt-4 text-lg text-slate-400">
        Get in touch — we will prepare a free quote and visualization for your project.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
        <a
          href="/en/contact"
          class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-red-600 hover:bg-red-500 text-white font-bold text-lg rounded-xl transition-all duration-300 hover:shadow-2xl hover:shadow-red-600/25"
        >
          Free Quote
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a href="tel:+48515156233" class="inline-flex items-center justify-center gap-3 px-8 py-4 border border-slate-600 hover:border-red-500/50 text-white font-semibold text-lg rounded-xl transition-all duration-300 hover:bg-white/5">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call: 515-156-233
        </a>
      </div>
    </div>
  </section>
</Layout>
