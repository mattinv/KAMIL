---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Contact — Free Facade Quote in 24h"
  description="Contact Elewacje z Klasa — free facade and insulation quotes. Online quote form, technical consulting, Clean Air program assistance."
  schemaType="contact"
  locale="en"
>
  <!-- Hero -->
  <section class="relative pt-32 pb-16 bg-slate-900 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/projects/osiedle-front.jpg" alt="Housing estate with facade — contact Elewacje z Klasa" class="w-full h-full object-cover opacity-10" />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900/80 via-slate-900/95 to-slate-900"></div>
    </div>
    <div class="absolute top-0 left-0 w-full h-1.5 bg-red-600"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-500/10 border border-orange-500/20 mb-6">
        <span class="text-orange-400 text-sm font-semibold">Contact & Quote</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight">
        Free <span class="text-gradient">Quote</span>
      </h1>
      <p class="mt-6 text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Fill out the form and we will prepare a detailed quote within 24 hours.
        The more details you provide, the more accurate the offer will be.
      </p>

      <!-- Contact quick info -->
      <div class="flex flex-wrap justify-center gap-6 mt-10">
        <a href="tel:+48515156233" class="flex items-center gap-3 px-5 py-3 bg-white/5 border border-white/10 rounded-xl hover:bg-white/10 transition-colors">
          <svg class="w-5 h-5 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="text-white font-medium">515-156-233</span>
        </a>
        <a href="mailto:biuro@elewacjezklasa.pl" class="flex items-center gap-3 px-5 py-3 bg-white/5 border border-white/10 rounded-xl hover:bg-white/10 transition-colors">
          <svg class="w-5 h-5 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="text-white font-medium">biuro@elewacjezklasa.pl</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Form -->
  <section class="section-padding bg-slate-50">
    <div class="max-w-4xl mx-auto">
      <!-- Quote type toggle -->
      <div class="flex justify-center mb-12">
        <div class="inline-flex bg-white rounded-xl border border-slate-200 p-1.5 shadow-sm">
          <button id="btn-fast" class="quote-toggle px-6 py-3 text-sm font-semibold rounded-lg transition-all bg-red-600 text-white shadow-sm" data-mode="fast">
            Quick Quote
          </button>
          <button id="btn-detailed" class="quote-toggle px-6 py-3 text-sm font-semibold rounded-lg transition-all text-slate-500 hover:text-slate-700" data-mode="detailed">
            Detailed Consultation
          </button>
        </div>
      </div>

      <form
        id="contact-form"
        action="https://formsubmit.co/biuro@elewacjezklasa.pl"
        method="POST"
        enctype="multipart/form-data"
        class="bg-white rounded-3xl border border-slate-100 shadow-xl shadow-slate-900/5 p-8 lg:p-12 space-y-10"
      >
        <!-- FormSubmit config -->
        <input type="hidden" name="_subject" value="New inquiry (EN) — Elewacje z Klasa" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="text" name="_honey" style="display:none" />

        <!-- Section 1: Contact Info -->
        <div>
          <h2 class="text-lg font-bold text-slate-900 mb-1">Contact Details</h2>
          <p class="text-sm text-slate-400 mb-6">How can we reach you?</p>
          <div class="grid sm:grid-cols-3 gap-5">
            <div>
              <label for="name" class="block text-sm font-semibold text-slate-700 mb-2">Full Name *</label>
              <input type="text" id="name" name="Full Name" required placeholder="John Smith"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-semibold text-slate-700 mb-2">Phone *</label>
              <input type="tel" id="phone" name="Phone" required placeholder="+48 515 156 233"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all" />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-slate-700 mb-2">Email *</label>
              <input type="email" id="email" name="Email" required placeholder="john@example.com"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all" />
            </div>
          </div>
        </div>

        <hr class="border-slate-100" />

        <!-- Section 2: Basic Project Info -->
        <div>
          <h2 class="text-lg font-bold text-slate-900 mb-1">Project Information</h2>
          <p class="text-sm text-slate-400 mb-6">Basic details for your quote.</p>

          <!-- Investment Type -->
          <div class="mb-6">
            <label class="block text-sm font-semibold text-slate-700 mb-3">Investment Type *</label>
            <div class="grid grid-cols-3 gap-3">
              {['Single-family home', 'Commercial building', 'Multi-family building'].map((type) => (
                <label class="invest-type relative cursor-pointer">
                  <input type="radio" name="Investment Type" value={type} class="sr-only peer" required />
                  <div class="px-4 py-3.5 rounded-xl border-2 border-slate-200 text-center text-sm font-medium text-slate-600 peer-checked:border-red-500 peer-checked:bg-red-50 peer-checked:text-red-700 hover:border-slate-300 transition-all">
                    {type}
                  </div>
                </label>
              ))}
            </div>
          </div>

          <div class="mb-6">
            <label for="service-type" class="block text-sm font-semibold text-slate-700 mb-2">Service Type *</label>
            <select id="service-type" name="Service Type" required
              class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all">
              <option value="">Select a service...</option>
              <option value="Insulation (ETICS)">Insulation (ETICS)</option>
              <option value="Ventilated facade">Ventilated facade</option>
              <option value="Decorative plasters">Decorative plasters</option>
              <option value="Facade cleaning">Facade cleaning</option>
              <option value="Commercial project">Commercial project</option>
              <option value="Consulting & 3D visualization">Consulting & 3D visualization</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="grid sm:grid-cols-3 gap-5">
            <div>
              <label for="location" class="block text-sm font-semibold text-slate-700 mb-2">Location *</label>
              <input type="text" id="location" name="Location" required placeholder="City or postal code"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all" />
            </div>
            <div>
              <label for="area" class="block text-sm font-semibold text-slate-700 mb-2">Facade Area (m²) *</label>
              <input type="number" id="area" name="Facade Area m2" required placeholder="e.g. 200"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all" />
            </div>
            <div>
              <label for="status" class="block text-sm font-semibold text-slate-700 mb-2">Building Status</label>
              <select id="status" name="Building Status"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all">
                <option value="">Select...</option>
                <option value="New construction">New construction</option>
                <option value="Existing building renovation">Existing building renovation</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Section 3: Technical Parameters (detailed mode) -->
        <div id="detailed-section" class="hidden">
          <hr class="border-slate-100 mb-10" />
          <div>
            <h2 class="text-lg font-bold text-slate-900 mb-1">Technical Parameters</h2>
            <p class="text-sm text-slate-400 mb-6">Precise data for an accurate quote.</p>

            <div class="grid sm:grid-cols-3 gap-5 mb-6">
              <div>
                <label for="insulation" class="block text-sm font-semibold text-slate-700 mb-2">Insulation Material</label>
                <select id="insulation" name="Insulation Material"
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all">
                  <option value="">Select...</option>
                  <option value="Graphite polystyrene">Graphite polystyrene</option>
                  <option value="Mineral wool">Mineral wool</option>
                  <option value="PIR / Special boards">PIR / Special boards</option>
                  <option value="Not sure — need advice">Not sure — need advice</option>
                </select>
              </div>
              <div>
                <label for="thickness" class="block text-sm font-semibold text-slate-700 mb-2">Insulation Thickness</label>
                <select id="thickness" name="Insulation Thickness"
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all">
                  <option value="">Select...</option>
                  <option value="15 cm">15 cm</option>
                  <option value="20 cm">20 cm</option>
                  <option value="25 cm+">25 cm+</option>
                  <option value="To be determined">To be determined with advisor</option>
                </select>
              </div>
              <div>
                <label for="finish" class="block text-sm font-semibold text-slate-700 mb-2">Finish / Plaster</label>
                <select id="finish" name="Finish"
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all">
                  <option value="">Select...</option>
                  <option value="Silicone plaster">Silicone plaster (standard)</option>
                  <option value="Silicate-silicone plaster">Silicate-silicone plaster</option>
                  <option value="Architectural concrete">Architectural concrete effect</option>
                  <option value="Facade board">Wood imitation (facade board)</option>
                  <option value="Ventilated facade">Ventilated facade</option>
                </select>
              </div>
            </div>

            <!-- Premium options -->
            <div class="mb-6">
              <label class="block text-sm font-semibold text-slate-700 mb-3">Decorative Elements</label>
              <div class="grid sm:grid-cols-2 gap-3">
                {[
                  'Architectural profiles and moldings',
                  'LED lighting integration',
                  'Stone / quartz cladding',
                  'HPL panels',
                ].map((item) => (
                  <label class="flex items-center gap-3 px-4 py-3 rounded-xl border border-slate-200 hover:border-slate-300 cursor-pointer transition-all has-[:checked]:border-red-500 has-[:checked]:bg-red-50">
                    <input type="checkbox" name="Decorative Elements" value={item} class="w-4 h-4 text-red-600 rounded border-slate-300 focus:ring-red-500" />
                    <span class="text-sm text-slate-700">{item}</span>
                  </label>
                ))}
              </div>
            </div>

            <!-- Brand preference -->
            <div class="mb-6">
              <label for="brand" class="block text-sm font-semibold text-slate-700 mb-2">Preferred System / Brand (optional)</label>
              <select id="brand" name="Preferred Brand"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all">
                <option value="">No preference</option>
                <option value="Sto">Sto</option>
                <option value="Weber">Weber (Saint-Gobain)</option>
                <option value="Caparol">Caparol</option>
                <option value="Baumit">Baumit</option>
                <option value="Atlas">Atlas</option>
                <option value="Ceresit">Ceresit</option>
              </select>
            </div>

            <!-- Additional work -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-3">Additional Work</label>
              <div class="grid sm:grid-cols-3 gap-3">
                {[
                  'External window sills',
                  'Base/plinth finishing',
                  'Soffit boards',
                ].map((item) => (
                  <label class="flex items-center gap-3 px-4 py-3 rounded-xl border border-slate-200 hover:border-slate-300 cursor-pointer transition-all has-[:checked]:border-red-500 has-[:checked]:bg-red-50">
                    <input type="checkbox" name="Additional Work" value={item} class="w-4 h-4 text-red-600 rounded border-slate-300 focus:ring-red-500" />
                    <span class="text-sm text-slate-700">{item}</span>
                  </label>
                ))}
              </div>
            </div>
          </div>

          <hr class="border-slate-100 mt-10 mb-10" />

          <!-- Section 4: Clean Air -->
          <div>
            <h2 class="text-lg font-bold text-slate-900 mb-1">
              "Clean Air" Program
              <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700">Subsidy</span>
            </h2>
            <p class="text-sm text-slate-400 mb-6">We help obtain funding from the government program.</p>

            <div class="grid sm:grid-cols-3 gap-5 mb-6">
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-3">Are you applying for a subsidy?</label>
                <div class="flex gap-3">
                  <label class="flex-1 cursor-pointer">
                    <input type="radio" name="Clean Air" value="Yes" class="sr-only peer" />
                    <div class="px-4 py-3 rounded-xl border-2 border-slate-200 text-center text-sm font-medium text-slate-600 peer-checked:border-green-500 peer-checked:bg-green-50 peer-checked:text-green-700 hover:border-slate-300 transition-all">
                      Yes
                    </div>
                  </label>
                  <label class="flex-1 cursor-pointer">
                    <input type="radio" name="Clean Air" value="No" class="sr-only peer" />
                    <div class="px-4 py-3 rounded-xl border-2 border-slate-200 text-center text-sm font-medium text-slate-600 peer-checked:border-slate-400 peer-checked:bg-slate-50 peer-checked:text-slate-700 hover:border-slate-300 transition-all">
                      No
                    </div>
                  </label>
                </div>
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-3">Help with documentation?</label>
                <div class="flex gap-3">
                  <label class="flex-1 cursor-pointer">
                    <input type="radio" name="Documentation Help" value="Yes" class="sr-only peer" />
                    <div class="px-4 py-3 rounded-xl border-2 border-slate-200 text-center text-sm font-medium text-slate-600 peer-checked:border-green-500 peer-checked:bg-green-50 peer-checked:text-green-700 hover:border-slate-300 transition-all">
                      Yes
                    </div>
                  </label>
                  <label class="flex-1 cursor-pointer">
                    <input type="radio" name="Documentation Help" value="No" class="sr-only peer" />
                    <div class="px-4 py-3 rounded-xl border-2 border-slate-200 text-center text-sm font-medium text-slate-600 peer-checked:border-slate-400 peer-checked:bg-slate-50 peer-checked:text-slate-700 hover:border-slate-300 transition-all">
                      No
                    </div>
                  </label>
                </div>
              </div>
              <div>
                <label for="building-year" class="block text-sm font-semibold text-slate-700 mb-2">Year of Construction</label>
                <input type="number" id="building-year" name="Year of Construction" placeholder="e.g. 1985" min="1900" max="2026"
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all" />
              </div>
            </div>
          </div>

          <hr class="border-slate-100 mt-10 mb-10" />

          <!-- Section 5: File Upload -->
          <div>
            <h2 class="text-lg font-bold text-slate-900 mb-1">Attachments</h2>
            <p class="text-sm text-slate-400 mb-6">Architectural plans or building photos increase quote accuracy by ~20%.</p>

            <label class="block cursor-pointer">
              <div class="border-2 border-dashed border-slate-200 rounded-2xl p-8 text-center hover:border-orange-400 hover:bg-orange-50/30 transition-all">
                <svg class="w-10 h-10 text-slate-300 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                </svg>
                <p class="text-sm font-semibold text-slate-600">Drag files or click to select</p>
                <p class="text-xs text-slate-400 mt-1">PDF, JPG, PNG — max. 10 MB</p>
              </div>
              <input type="file" name="attachment" multiple accept=".pdf,.jpg,.jpeg,.png" class="sr-only" />
            </label>
          </div>
        </div>

        <hr class="border-slate-100" />

        <!-- Message -->
        <div>
          <label for="message" class="block text-sm font-semibold text-slate-700 mb-2">Message / Notes</label>
          <textarea id="message" name="Message" rows="4" placeholder="Describe your project, expectations, timeline..."
            class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all resize-none"></textarea>
        </div>

        <!-- Submit -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-xs text-slate-400 max-w-sm">
            By submitting this form, you consent to the processing of your data for the purpose of preparing a quote.
            We respond within 24 hours.
          </p>
          <button type="submit" id="submit-btn"
            class="w-full sm:w-auto px-10 py-4 bg-red-600 hover:bg-red-500 text-white font-bold text-lg rounded-xl transition-all duration-300 hover:shadow-lg hover:shadow-red-600/25 hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-3">
            <span>Send Inquiry</span>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </button>
        </div>
      </form>

      <!-- Success message (hidden by default) -->
      <div id="success-msg" class="hidden mt-8 p-8 bg-green-50 border border-green-200 rounded-2xl text-center">
        <svg class="w-12 h-12 text-green-500 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-xl font-bold text-green-800">Message sent!</h3>
        <p class="text-green-600 mt-2">Thank you for your inquiry. We will contact you within 24 hours.</p>
      </div>
    </div>
  </section>

  <!-- Map / Location -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-slate-50 rounded-2xl p-8 text-center">
          <svg class="w-8 h-8 text-red-500 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <h3 class="font-bold text-slate-900">Service Area</h3>
          <p class="text-slate-500 text-sm mt-2">Malopolska and surroundings<br/>All of Poland for larger projects</p>
        </div>
        <div class="bg-slate-50 rounded-2xl p-8 text-center">
          <svg class="w-8 h-8 text-red-500 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h3 class="font-bold text-slate-900">Business Hours</h3>
          <p class="text-slate-500 text-sm mt-2">Mon-Fri: 7:00-17:00<br/>Sat: 8:00-14:00</p>
        </div>
        <div class="bg-slate-50 rounded-2xl p-8 text-center">
          <svg class="w-8 h-8 text-red-500 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <h3 class="font-bold text-slate-900">Response Time</h3>
          <p class="text-slate-500 text-sm mt-2">Quote within 24h<br/>Urgent inquiries: call us</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Toggle between fast/detailed quote
  const btnFast = document.getElementById('btn-fast');
  const btnDetailed = document.getElementById('btn-detailed');
  const detailedSection = document.getElementById('detailed-section');

  function setMode(mode: string) {
    if (mode === 'fast') {
      btnFast?.classList.add('bg-red-600', 'text-white', 'shadow-sm');
      btnFast?.classList.remove('text-slate-500');
      btnDetailed?.classList.remove('bg-red-600', 'text-white', 'shadow-sm');
      btnDetailed?.classList.add('text-slate-500');
      detailedSection?.classList.add('hidden');
    } else {
      btnDetailed?.classList.add('bg-red-600', 'text-white', 'shadow-sm');
      btnDetailed?.classList.remove('text-slate-500');
      btnFast?.classList.remove('bg-red-600', 'text-white', 'shadow-sm');
      btnFast?.classList.add('text-slate-500');
      detailedSection?.classList.remove('hidden');
    }
  }

  btnFast?.addEventListener('click', () => setMode('fast'));
  btnDetailed?.addEventListener('click', () => setMode('detailed'));
</script>
