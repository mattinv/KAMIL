---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Stats from '../../components/Stats.astro';
import Services from '../../components/Services.astro';
import TextureShowcase from '../../components/TextureShowcase.astro';
import Portfolio from '../../components/Portfolio.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Partners from '../../components/Partners.astro';
import Contact from '../../components/Contact.astro';

const faqItems = [
  {
    q: 'How much does house insulation cost in Krakow in 2026?',
    a: 'The cost of insulating a single-family home in Krakow depends on the facade area, type of insulation, and finish. Approximate prices: graphite polystyrene with silicone plaster from 180-250 PLN/m², mineral wool from 220-300 PLN/m². For a house with 200 m² of facade area, this means 36,000-60,000 PLN. We prepare free, detailed estimates based on an on-site inspection.'
  },
  {
    q: 'Graphite polystyrene or mineral wool — which should I choose for insulation?',
    a: 'Graphite polystyrene (lambda = 0.031) is cheaper and lighter — ideal for most single-family homes. Mineral wool (fire class A1) is non-combustible and vapor-permeable — better for wooden buildings, multi-family buildings, and anywhere fire safety is a priority. We help you select the optimal material for your building.'
  },
  {
    q: 'Do you help with the Clean Air program subsidy?',
    a: 'Yes — as an authorized partner of the Clean Air (Czyste Powietrze) program, we offer comprehensive assistance: from checking eligibility, through completing the application, to settling the subsidy after work completion. In 2026, the insulation subsidy amounts to up to 135,000 PLN depending on the funding level.'
  },
  {
    q: 'How long does insulating and finishing a single-family home take?',
    a: 'Standard insulation of a single-family home (150-250 m² of facade) takes 3-5 weeks, depending on weather and project complexity. Before starting work, we establish a detailed schedule and adhere to the agreed deadlines.'
  },
  {
    q: 'Can facade work be done in winter?',
    a: 'ETICS facade work requires temperatures above +5°C. The facade season in Krakow typically runs from March to November. In case of a mild winter or with the use of enclosures and heaters, work can also be carried out during winter months — we assess this on a case-by-case basis.'
  },
  {
    q: 'Which facade plaster is the most durable?',
    a: 'Silicone plaster is the most commonly chosen and durable facade finish. It is self-cleaning (hydrophobic), resistant to algae and fungi, with a durability of 20-30 years. For buildings in the city center, we also recommend silicate-silicone plaster, which combines vapor permeability with self-cleaning properties.'
  },
];
---

<Layout
  title="Professional Insulation & Facades Kraków | Elewacje z Klasą"
  description="Professional facades and thermal modernization in Malopolska. ETICS systems, ventilated facades, commercial projects. Authorized Clean Air partner. Over 15 years of experience."
  locale="en"
  faqItems={faqItems}
>
  <Hero locale="en" />
  <Stats locale="en" />

  <!-- SEO Introduction Section -->
  <section class="section-padding bg-white">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-50 border border-orange-200 mb-6">
          <span class="text-orange-600 text-sm font-semibold">Krakow & Malopolska</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
          Professional Facade Construction<br />
          <span class="text-gradient">& Thermal Modernization</span> in Malopolska
        </h2>
      </div>

      <div class="space-y-6 text-lg text-slate-500 leading-relaxed">
        <p>
          Based in <strong class="text-slate-800">Krakow</strong>, our construction company delivers
          top-tier solutions for residential and commercial buildings, with a particular focus on
          maximizing <strong class="text-slate-800">energy efficiency</strong>.
          We specialize in <strong class="text-slate-800">premium facades</strong> and advanced
          cladding systems, using products from the most renowned EU brands and the highest quality
          insulation materials. This ensures our projects maintain durability and world-class aesthetics
          for years to come.
        </p>

        <p>
          As an <strong class="text-slate-800">authorized partner of the "Clean Air" (Czyste Powietrze) program</strong>,
          we set the standard for thermal modernization across the Malopolska region. Our team
          provides comprehensive support — from professional technical consulting and premium execution,
          to finalizing complex subsidy documentation. Whether you are undertaking a major
          <strong class="text-slate-800">commercial investment</strong> or building a
          <strong class="text-slate-800">luxury private residence</strong>, we help optimize
          costs, reduce energy expenses, and care for the environment through cutting-edge
          insulation technologies.
        </p>
      </div>

      <!-- Key highlights -->
      <div class="grid sm:grid-cols-3 gap-6 mt-10">
        <div class="flex items-start gap-3">
          <svg class="w-6 h-6 text-red-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <div>
            <h3 class="font-bold text-slate-900 text-sm">"Clean Air" Partner</h3>
            <p class="text-slate-500 text-sm mt-1">Subsidy documentation assistance</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-6 h-6 text-red-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <div>
            <h3 class="font-bold text-slate-900 text-sm">Based in Krakow</h3>
            <p class="text-slate-500 text-sm mt-1">Projects across Malopolska</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-6 h-6 text-red-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
          </svg>
          <div>
            <h3 class="font-bold text-slate-900 text-sm">Premium EU Brands</h3>
            <p class="text-slate-500 text-sm mt-1">Weber, Caparol, Baumit, Sto</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Services locale="en" />
  <TextureShowcase locale="en" />
  <Portfolio locale="en" />

  <!-- Trust Badges -->
  <section class="py-12 bg-slate-50 border-y border-slate-100">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 items-center">
        <div class="flex flex-col items-center text-center gap-3">
          <div class="w-14 h-14 rounded-2xl bg-green-50 border border-green-200 flex items-center justify-center">
            <svg class="w-7 h-7 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
