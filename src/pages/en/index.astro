            </svg>
          </div>
          <div>
            <p class="font-bold text-slate-900 text-sm">Clean Air Partner</p>
            <p class="text-slate-400 text-xs mt-0.5">Authorized contractor</p>
          </div>
        </div>
        <div class="flex flex-col items-center text-center gap-3">
          <div class="w-14 h-14 rounded-2xl bg-red-50 border border-red-200 flex items-center justify-center">
            <svg class="w-7 h-7 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <div>
            <p class="font-bold text-slate-900 text-sm">Up to 10 Year Warranty</p>
            <p class="text-slate-400 text-xs mt-0.5">On completed work</p>
          </div>
        </div>
        <div class="flex flex-col items-center text-center gap-3">
          <div class="w-14 h-14 rounded-2xl bg-blue-50 border border-blue-200 flex items-center justify-center">
            <svg class="w-7 h-7 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
            </svg>
          </div>
          <div>
            <p class="font-bold text-slate-900 text-sm">ETICS Certified</p>
            <p class="text-slate-400 text-xs mt-0.5">Weber, Baumit, Sto systems</p>
          </div>
        </div>
        <div class="flex flex-col items-center text-center gap-3">
          <div class="w-14 h-14 rounded-2xl bg-orange-50 border border-orange-200 flex items-center justify-center">
            <svg class="w-7 h-7 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M18.75 4.236c.982.143 1.954.317 2.916.52A6.003 6.003 0 0016.27 9.728M18.75 4.236V4.5c0 2.108-.966 3.99-2.48 5.228m0 0a6.023 6.023 0 01-7.54 0" />
            </svg>
          </div>
          <div>
            <p class="font-bold text-slate-900 text-sm">15+ Years of Experience</p>
            <p class="text-slate-400 text-xs mt-0.5">Over 300 completed projects</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Elewacje z Klasa -->
  <section class="section-padding bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-sm font-semibold text-orange-500 uppercase tracking-wider mb-2">Why us</p>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          What sets <span class="text-gradient">Elewacje z Klasa</span> apart?
        </h2>
        <p class="mt-4 text-slate-500 max-w-2xl mx-auto">
          By choosing our facade company in Krakow, you gain certainty of quality and timeliness at every stage of your investment.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100">
          <div class="w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Up to 10 Year Warranty</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            We provide a written warranty on every project. House insulation in Krakow with our company is an investment secured for years — both thermally and aesthetically.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100">
          <div class="w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Clean Air Subsidy Assistance</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            As an authorized partner of the Clean Air program, we help obtain funding for thermal modernization — from completing the application to settling the subsidy. Grants up to 135,000 PLN for insulation and heating source replacement.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100">
          <div class="w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Certified Materials</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            We exclusively use materials from renowned manufacturers: Weber, Caparol, Baumit, Sto, and Atlas. Graphite polystyrene, mineral wool, and silicone plasters with full documentation and technical approvals.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100">
          <div class="w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">3D Visualization Before Starting</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            Before starting work, we prepare a 3D facade visualization so you can see the final result. We select colors, plaster texture, and architectural details — eliminating the risk of wrong choices.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100">
          <div class="w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">On-Time Delivery</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            A single-family home facade typically takes 3-5 weeks. We establish a schedule before signing the contract and meet deadlines — no delays, no hidden costs.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100">
          <div class="w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Free Quote in 24h</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            How much does a facade cost in 2026? Simply fill out the form or call us. We prepare a detailed insulation and facade quote free of charge, with on-site visit within Krakow and surroundings.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area -->
  <section class="section-padding bg-slate-50">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-sm font-semibold text-orange-500 uppercase tracking-wider mb-2">Service area</p>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-6">
            House Insulation in <span class="text-gradient">Krakow & Malopolska</span>
          </h2>
          <div class="space-y-4 text-slate-500 leading-relaxed">
            <p>
              Our office is located in Krakow at ul. Kobierzynska 103/5. We carry out facade and thermal modernization projects throughout the entire Malopolska region — from Krakow, through Wieliczka, Myslenice, and Oswiecim, to Tarnow and Nowy Sacz.
            </p>
            <p>
              For larger commercial and development investments, we operate throughout Poland. Our clients include single-family homeowners, housing communities, developers, and public institutions.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 mt-6">
            {['Krakow', 'Wieliczka', 'Skawina', 'Myslenice', 'Oswiecim', 'Wadowice', 'Bochnia', 'Tarnow', 'Nowy Sacz', 'Zakopane', 'Niepolomice', 'Proszowice'].map((city) => (
              <span class="px-3 py-1.5 bg-white border border-slate-200 rounded-lg text-sm text-slate-600">{city}</span>
            ))}
          </div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-8 space-y-6">
          <h3 class="text-lg font-bold text-slate-900">Our services in the region</h3>
          <ul class="space-y-4">
            {[
              { title: 'House Insulation Krakow', desc: 'ETICS systems with graphite polystyrene or mineral wool, prices from 180 PLN/m²' },
              { title: 'Ventilated Facades Krakow', desc: 'Modern HPL and fiber-cement facades for homes and office buildings' },
              { title: 'Thermal Modernization Malopolska', desc: 'Comprehensive energy modernization with audit and Clean Air subsidy' },
              { title: 'Decorative & Silicone Plasters', desc: 'Silicone, silicate, lamb, and bark beetle plaster — durable facade finishes' },
              { title: 'Facade Cleaning & Washing', desc: 'Pressure washing, algae and graffiti removal, hydrophobic impregnation' },
            ].map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <div>
                  <p class="font-semibold text-slate-900 text-sm">{item.title}</p>
                  <p class="text-slate-500 text-sm">{item.desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ on homepage -->
  <section class="section-padding bg-white">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-sm font-semibold text-orange-500 uppercase tracking-wider mb-2">Frequently asked questions</p>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Questions about <span class="text-gradient">facades & insulation</span>
        </h2>
      </div>
      <div class="space-y-4">
        {faqItems.map((item) => (
          <details class="group bg-slate-50 rounded-2xl border border-slate-100 overflow-hidden">
            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none">
              <h3 class="text-base font-semibold text-slate-900 group-open:text-red-600 transition-colors">{item.q}</h3>
              <span class="text-slate-400 group-open:rotate-45 transition-transform duration-300 flex-shrink-0 text-2xl leading-none">+</span>
            </summary>
            <div class="px-6 pb-5">
              <p class="text-slate-500 leading-relaxed">{item.a}</p>
            </div>
          </details>
        ))}
      </div>
      <div class="text-center mt-8">
        <p class="text-slate-500 text-sm mb-4">Have another question? Check our blog or contact us.</p>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href="/en/blog" class="inline-flex items-center gap-2 px-5 py-2.5 border border-slate-200 hover:border-red-200 text-slate-700 hover:text-red-600 font-semibold text-sm rounded-xl transition-all">
