---
import Layout from '../../layouts/Layout.astro';
import Partners from '../../components/Partners.astro';

const services = [
  {
    id: 'etics',
    title: 'Systemy Ociepleń (ETICS)',
    subtitle: 'Metoda lekka-mokra',
    description: 'Kompleksowe ocieplenia budynków metodą lekką-mokrą. Stosujemy certyfikowane systemy Weber, Baumit, Caparol i Atlas z pełną gwarancją producenta. System ETICS to najczęściej wybierana metoda termomodernizacji w Polsce — łączy izolację termiczną z estetycznym wykończeniem elewacji.',
    image: '/images/projects/dom-ocieplenie-styropian.jpg',
    features: [
      'Styropian EPS 70/80 — standard budowlany',
      'Styropian grafitowy — o 20% lepszy współczynnik λ',
      'Styropian XPS — izolacja cokołowa i fundamentowa',
      'Wełna mineralna — niepalna, paroprzepuszczalna',
      'Tynki silikonowe, silikatowe i akrylowe',
      'Klasa energetyczna A+ po ociepleniu',
    ],
    process: ['Audyt i pomiar budynku', 'Dobór systemu i materiałów', 'Przygotowanie podłoża', 'Klejenie izolacji i kołkowanie', 'Zatapianie siatki zbrojącej', 'Gruntowanie i tynkowanie', 'Malowanie i detale'],
  },
  {
    id: 'wentylowane',
    title: 'Elewacje Wentylowane',
    subtitle: 'Nowoczesne fasady',
    description: 'Nowoczesne fasady wentylowane z płyt HPL, włókno-cementowych oraz paneli aluminiowych. System elewacji wentylowanej zapewnia doskonałą izolację termiczną, akustyczną i trwałość ponad 50 lat. Idealne rozwiązanie dla budynków komercyjnych i prestiżowych rezydencji.',
    image: '/images/projects/kamienica-front.jpg',
    features: [
      'Płyty HPL (Trespa, Fundermax)',
      'Panele włókno-cementowe (Equitone, Cedral)',
      'Panele aluminiowe kompozytowe',
      'Okładziny ceramiczne wielkoformatowe',
      'Podkonstrukcja aluminiowa lub stalowa',
      'Wentylowana szczelina powietrzna',
    ],
    process: ['Projekt techniczny fasady', 'Montaż podkonstrukcji', 'Izolacja termiczna wełną', 'Membrana wiatroizolacyjna', 'Montaż okładzin', 'Obróbki detali i attyk'],
  },
  {
    id: 'tynki',
    title: 'Tynki Dekoracyjne i Strukturalne',
    subtitle: 'Wykończenie elewacji',
    description: 'Szeroki wybór tynków dekoracyjnych i strukturalnych do wykończenia elewacji. Od klasycznego baranka i kornika, przez tynki modelowane, po efekt betonu architektonicznego. Dobieramy fakturę i kolorystykę do charakteru budynku.',
    image: '/images/projects/dom-szary-flaga.jpg',
    features: [
      'Tynk baranek — klasyczna faktura',
      'Tynk kornik — strukturalny wzór',
      'Tynk silikonowy — samoczyszczący',
      'Tynk silikatowy — paroprzepuszczalny',
      'Tynk mozaikowy — cokół i detale',
      'Efekt betonu architektonicznego',
    ],
    process: ['Dobór faktury i koloru', 'Wizualizacja elewacji', 'Przygotowanie podłoża', 'Gruntowanie', 'Nakładanie tynku', 'Formowanie struktury'],
  },
  {
    id: 'komercyjne',
    title: 'Projekty Komercyjne',
    subtitle: 'Dla deweloperów i inwestorów',
    description: 'Realizacje dla deweloperów, inwestorów i sektora publicznego. Biurowce, hale, centra handlowe i budynki wielorodzinne. Oferujemy pełną obsługę inwestycji — od projektu elewacji, przez wykonanie, po dokumentację powykonawczą.',
    image: '/images/projects/budynek-wielorodzinny.jpg',
    features: [
      'Budynki wielorodzinne i osiedla',
      'Obiekty biurowe i handlowe',
      'Hale przemysłowe i magazynowe',
      'Obiekty użyteczności publicznej',
      'Kompleksowa dokumentacja',
      'Obsługa gwarancyjna',
    ],
    process: ['Analiza projektu i dokumentacji', 'Wycena i harmonogram', 'Montaż rusztowań', 'Realizacja prac elewacyjnych', 'Kontrola jakości', 'Odbiór i dokumentacja'],
  },
  {
    id: 'doradztwo',
    title: 'Fachowe Doradztwo',
    subtitle: 'Wizualizacje i projekty',
    description: 'Profesjonalne doradztwo w zakresie doboru materiałów, kolorystyki i systemów elewacyjnych. Przygotowujemy wizualizacje 3D elewacji, dzięki którym zobaczysz efekt końcowy jeszcze przed rozpoczęciem prac.',
    image: '/images/projects/osiedle-front.jpg',
    features: [
      'Wizualizacje 3D elewacji',
      'Dobór kolorystyki i materiałów',
      'Analiza techniczna podłoża',
      'Doradztwo energetyczne',
      'Kosztorys i harmonogram',
      'Pomoc w uzyskaniu dotacji',
    ],
    process: ['Wizja lokalna', 'Pomiar i dokumentacja', 'Projekt kolorystyczny', 'Wizualizacja 3D', 'Wycena materiałów i robocizny', 'Prezentacja i akceptacja'],
  },
];

const iconPaths: Record<string, string> = {
  etics: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
  wentylowane: 'M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z',
  tynki: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
  komercyjne: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  doradztwo: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
};
---

<Layout
  title="Usługi Elewacyjne i Ociepleniowe Kraków"
  description="Kompleksowe usługi elewacyjne — systemy ociepleń ETICS, elewacje wentylowane, tynki dekoracyjne, projekty komercyjne i fachowe doradztwo z wizualizacjami 3D."
  schemaType="services"
>
  <!-- Page Hero -->
  <section class="relative pt-32 pb-20 bg-slate-900 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/projects/dom-parterowy.jpg" alt="Elewacja domu parterowego — usługi elewacyjne Kraków" class="w-full h-full object-cover opacity-15" />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900/80 via-slate-900/90 to-slate-900"></div>
    </div>
    <div class="absolute top-0 left-0 w-full h-1.5 bg-red-600"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-500/10 border border-orange-500/20 mb-6">
        <span class="text-orange-400 text-sm font-semibold">Usługi</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight">
        Nasze <span class="text-gradient">Usługi</span>
      </h1>
      <p class="mt-6 text-lg text-slate-400 max-w-2xl leading-relaxed">
        Od ocieplenia po elewacje wentylowane — kompleksowa obsługa
        projektów fasadowych dla klientów indywidualnych i komercyjnych.
      </p>
    </div>
  </section>

  <!-- Quick Nav -->
  <section class="sticky top-20 z-30 bg-white/95 backdrop-blur-lg border-b border-slate-100 py-4">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex gap-2 overflow-x-auto scrollbar-hide">
        {services.map((s) => (
          <a
            href={`#${s.id}`}
            class="flex-shrink-0 px-4 py-2 text-sm font-medium text-slate-600 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all"
          >
            {s.title.split('(')[0].split('—')[0].trim()}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Service Sections -->
  {services.map((service, index) => (
    <section id={service.id} class={`section-padding ${index % 2 === 0 ? 'bg-white' : 'bg-slate-50'}`}>
      <div class="max-w-7xl mx-auto">
        <div class={`grid lg:grid-cols-2 gap-12 lg:gap-20 items-center ${index % 2 !== 0 ? 'lg:grid-flow-dense' : ''}`}>
          <!-- Image -->
          <div class={`relative ${index % 2 !== 0 ? 'lg:col-start-2' : ''}`}>
            <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-xl shadow-slate-900/10">
              <img
                src={service.image}
                alt={service.title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <!-- Decorative -->
            <div class="absolute -bottom-4 -right-4 w-32 h-32 bg-orange-500/10 rounded-2xl blur-2xl -z-10"></div>
          </div>

          <!-- Content -->
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-slate-900 to-slate-700 flex items-center justify-center">
                <svg class="w-6 h-6 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[service.id]} />
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-orange-500 uppercase tracking-wider">{service.subtitle}</p>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">{service.title}</h2>
              </div>
            </div>

            <p class="text-slate-500 leading-relaxed">{service.description}</p>

            <!-- Features -->
            <div>
              <h3 class="text-sm font-bold text-slate-700 uppercase tracking-wider mb-4">Co oferujemy</h3>
              <ul class="grid sm:grid-cols-2 gap-3">
                {service.features.map((f) => (
                  <li class="flex items-start gap-2.5 text-sm text-slate-600">
                    <svg class="w-4 h-4 text-red-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Process -->
            <div>
              <h3 class="text-sm font-bold text-slate-700 uppercase tracking-wider mb-4">Etapy realizacji</h3>
              <div class="flex flex-wrap gap-2">
                {service.process.map((step, i) => (
                  <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-slate-100 rounded-lg text-sm">
                    <span class="text-xs font-bold text-orange-500">{String(i + 1).padStart(2, '0')}</span>
                    <span class="text-slate-600">{step}</span>
                  </div>
                ))}
              </div>
            </div>

            <a
              href="/#kontakt"
              class="inline-flex items-center gap-2 px-6 py-3 bg-red-600 hover:bg-red-500 text-white font-semibold rounded-xl transition-all duration-300 hover:shadow-lg hover:shadow-red-600/25"
            >
              Zapytaj o wycenę
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  ))}

  <Partners />

  <!-- Detailed Service Pages -->
  <section class="section-padding bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-sm font-semibold text-orange-500 uppercase tracking-wider mb-2">Dowiedz się więcej</p>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Szczegółowe <span class="text-gradient">Poradniki</span>
        </h2>
        <p class="mt-4 text-slate-500 max-w-2xl mx-auto">
          Przeczytaj szczegółowe opisy naszych usług — materiały, proces, koszty i najczęściej zadawane pytania.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { href: '/uslugi/ocieplenie-domu-krakow', title: 'Ocieplenie Domu', desc: 'Systemy ETICS, styropian, wełna — kompletny poradnik ocieplania domu.' },
          { href: '/uslugi/elewacje-krakow', title: 'Elewacje Kraków', desc: 'Wszystkie usługi elewacyjne — od ocieplenia po tynki dekoracyjne.' },
          { href: '/uslugi/termomodernizacja-malopolska', title: 'Termomodernizacja', desc: 'Kompleksowa modernizacja energetyczna budynków w Małopolsce.' },
          { href: '/uslugi/elewacje-wentylowane-krakow', title: 'Elewacje Wentylowane', desc: 'Nowoczesne fasady HPL, włókno-cementowe i aluminiowe.' },
          { href: '/uslugi/tynk-silikonowy-elewacja', title: 'Tynk Silikonowy', desc: 'Samoczyszczący tynk silikonowy — trwałe wykończenie elewacji.' },
          { href: '/uslugi/renowacja-elewacji-kamienic', title: 'Renowacja Kamienic', desc: 'Odnowa zabytkowych fasad z uzgodnieniami konserwatorskimi.' },
          { href: '/uslugi/ocieplenie-styropianem-grafitowym', title: 'Styropian Grafitowy', desc: 'O 20% lepsza izolacja — cieńsza warstwa, lepszy efekt.' },
          { href: '/uslugi/ocieplenie-welna-mineralna', title: 'Wełna Mineralna', desc: 'Niepalna izolacja klasy A1 — paroprzepuszczalna i akustyczna.' },
          { href: '/uslugi/wizualizacja-elewacji-3d', title: 'Wizualizacja 3D', desc: 'Zobacz efekt końcowy przed rozpoczęciem prac elewacyjnych.' },
          { href: '/uslugi/czyste-powietrze-elewacja', title: 'Czyste Powietrze', desc: 'Dotacja do 135 000 zł na ocieplenie — pomagamy od wniosku po rozliczenie.' },
        ].map((item) => (
          <a href={item.href} class="group block p-6 rounded-2xl border border-slate-100 hover:border-red-200 bg-slate-50 hover:bg-red-50/50 transition-all duration-300">
            <h3 class="text-lg font-bold text-slate-900 group-hover:text-red-600 transition-colors">{item.title}</h3>
            <p class="mt-2 text-sm text-slate-500">{item.desc}</p>
            <span class="inline-flex items-center gap-1 mt-3 text-sm font-semibold text-red-600">
              Czytaj więcej
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-slate-900 text-center">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Potrzebujesz <span class="text-gradient">wyceny?</span>
      </h2>
      <p class="mt-4 text-lg text-slate-400">
        Skontaktuj się z nami — bezpłatna konsultacja i wycena w ciągu 24 godzin.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
        <a
          href="/#kontakt"
          class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-red-600 hover:bg-red-500 text-white font-bold text-lg rounded-xl transition-all duration-300 hover:shadow-2xl hover:shadow-red-600/25"
        >
          Darmowa Wycena
        </a>
        <a href="tel:+48518768737" class="inline-flex items-center justify-center gap-3 px-8 py-4 border border-slate-600 hover:border-red-500/50 text-white font-semibold text-lg rounded-xl transition-all duration-300 hover:bg-white/5">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          518-768-737
        </a>
      </div>
    </div>
  </section>
</Layout>
