---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => b.data.year - a.data.year);

---

<Layout
  title="Realizacje"
  description="Zobacz nasze zrealizowane projekty elewacji i ociepleń — domy jednorodzinne, budynki wielorodzinne i obiekty komercyjne w całej Polsce."
>
  <!-- Page Hero -->
  <section class="relative pt-32 pb-20 bg-slate-900 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute top-1/4 right-0 w-96 h-96 bg-orange-500/10 rounded-full blur-[128px]"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-500/10 border border-red-500/20 mb-6">
        <span class="text-orange-400 text-sm font-semibold">Portfolio</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight">
        Nasze <span class="text-gradient">Realizacje</span>
      </h1>
      <p class="mt-6 text-lg text-slate-400 max-w-2xl leading-relaxed">
        Każdy projekt to historia transformacji. Zobacz, jak zmieniamy budynki
        w energooszczędne i estetyczne obiekty.
      </p>
    </div>
  </section>

  <!-- Filter + Grid -->
  <section class="section-padding bg-slate-50">
    <div class="max-w-7xl mx-auto">
      <!-- Filter Tabs -->
      <div class="flex flex-wrap justify-center gap-2 mb-12">
        <button
          class="gallery-filter active px-6 py-2.5 rounded-xl text-sm font-semibold transition-all duration-300 bg-slate-900 text-white"
          data-filter="all"
        >
          Wszystkie ({sortedProjects.length})
        </button>
        <button
          class="gallery-filter px-6 py-2.5 rounded-xl text-sm font-semibold transition-all duration-300 bg-white text-slate-600 border border-slate-200 hover:border-slate-300"
          data-filter="dom"
        >
          Domy Jednorodzinne ({sortedProjects.filter(p => p.data.category === 'dom').length})
        </button>
        <button
          class="gallery-filter px-6 py-2.5 rounded-xl text-sm font-semibold transition-all duration-300 bg-white text-slate-600 border border-slate-200 hover:border-slate-300"
          data-filter="komercyjny"
        >
          Obiekty Komercyjne ({sortedProjects.filter(p => p.data.category === 'komercyjny').length})
        </button>
      </div>

      <!-- Projects Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedProjects.map((project) => {
          return (
            <article
              class="gallery-card group relative rounded-2xl overflow-hidden border border-slate-100 bg-white hover:shadow-2xl hover:shadow-slate-900/10 transition-all duration-500 hover:-translate-y-1"
              data-category={project.data.category}
            >
              <a href={`/realizacje/${project.id}`} class="block">
                <div class="aspect-[4/3] bg-slate-200 relative overflow-hidden">
                  {project.data.image && (
                    <img src={project.data.image} alt={project.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
                  )}
                  <div class="absolute top-4 left-4 flex gap-2">
                    <span class="px-3 py-1 bg-white/90 backdrop-blur-sm text-xs font-semibold text-slate-700 rounded-lg">
                      {project.data.categoryLabel}
                    </span>
                    <span class="px-3 py-1 bg-white/90 backdrop-blur-sm text-xs font-semibold text-slate-500 rounded-lg">
                      {project.data.year}
                    </span>
                  </div>
                  {project.data.featured && (
                    <div class="absolute top-4 right-4">
                      <span class="px-3 py-1 bg-red-600 text-xs font-bold text-white rounded-lg">
                        Wyróżniony
                      </span>
                    </div>
                  )}
                </div>

                <div class="p-6">
                  <h2 class="text-xl font-bold text-slate-900 group-hover:text-red-500 transition-colors">
                    {project.data.title}
                  </h2>
                  <p class="text-slate-500 text-sm mt-2 line-clamp-2">{project.data.description}</p>

                  <div class="mt-4 flex items-center gap-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">
                    <span class="flex items-center gap-1.5">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      {project.data.location}
                    </span>
                    <span>{project.data.area}</span>
                  </div>

                  <div class="mt-5 flex items-center gap-2 text-red-600 font-semibold text-sm">
                    <span>Zobacz projekt</span>
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </div>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-slate-900 text-center">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Masz projekt do <span class="text-gradient">zrealizowania?</span>
      </h2>
      <p class="mt-4 text-lg text-slate-400">
        Skontaktuj się z nami — przygotujemy bezpłatną wycenę.
      </p>
      <a
        href="/#kontakt"
        class="inline-flex items-center gap-3 mt-8 px-8 py-4 bg-red-600 hover:bg-red-500 text-white font-bold text-lg rounded-xl transition-all duration-300 hover:shadow-2xl hover:shadow-red-600/25"
      >
        Darmowa Wycena
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </section>
</Layout>

<script>
  const filterBtns = document.querySelectorAll('.gallery-filter');
  const cards = document.querySelectorAll('.gallery-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-slate-900', 'text-white');
        b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      });
      btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      btn.classList.add('bg-slate-900', 'text-white');

      const filter = btn.getAttribute('data-filter');

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
