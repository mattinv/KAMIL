---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Schema from '../components/Schema.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  schemaType?: 'home' | 'services' | 'projects' | 'about' | 'contact' | 'blog' | 'article';
  articleData?: {
    title: string;
    description: string;
    date: string;
    url: string;
  };
  faqItems?: { q: string; a: string }[];
  projectItems?: { title: string; description: string; image: string; location: string; year: number; slug: string }[];
}

const { title, description, image, type, schemaType = 'home', articleData, faqItems, projectItems } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <SEO title={title} description={description} image={image} type={type} />
    <Schema type={schemaType} articleData={articleData} faqItems={faqItems} projectItems={projectItems} />
  </head>
  <body class="bg-slate-50 text-slate-900 overflow-x-hidden">
    <Navigation />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
